<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 亮色：中性灰层级（参考专业修图软件） -->
    <Color x:Key="ColorBgCanvasWell">#D9D9D9</Color>
    <Color x:Key="ColorBgHeader">#EDEDED</Color>
    <Color x:Key="ColorBgPanel">#F5F5F5</Color>
    <Color x:Key="ColorBgCard">#FFFFFF</Color>
    <Color x:Key="ColorBgInput">#FFFFFF</Color>
    <Color x:Key="ColorBgHover">#E6E6E6</Color>
    <Color x:Key="ColorBgSelected">#DCE8FA</Color>
    <Color x:Key="ColorBgRaised">#FFFFFF</Color>
    <Color x:Key="ColorBgHud">#F5FFFFFF</Color>
    <Color x:Key="ColorBorderSubtle">#DEDEDE</Color>
    <Color x:Key="ColorBorderStrong">#C2C2C2</Color>
    <Color x:Key="ColorTextPrimary">#222222</Color>
    <Color x:Key="ColorTextSecondary">#555555</Color>
    <Color x:Key="ColorTextMuted">#808080</Color>
    <Color x:Key="ColorAccent">#1473E6</Color>
    <Color x:Key="ColorAccentHover">#0D66D0</Color>
    <Color x:Key="ColorAccentPressed">#095ABA</Color>
    <Color x:Key="ColorAccentSoft">#E6F0FC</Color>
    <Color x:Key="ColorFocusRing">#B31473E6</Color>
    <Color x:Key="ColorAccentText">#FFFFFF</Color>
    <Color x:Key="ColorStatusOk">#12805C</Color>
    <Color x:Key="ColorStatusOkSoft">#E2F2EB</Color>
    <Color x:Key="ColorStatusWarn">#CB6F10</Color>
    <Color x:Key="ColorStatusWarnSoft">#FBEFE0</Color>
    <Color x:Key="ColorStatusError">#C9252D</Color>
    <Color x:Key="ColorStatusErrorSoft">#FBE6E7</Color>
    <Color x:Key="ColorSliderThumb">#FFFFFF</Color>

    <SolidColorBrush x:Key="BrushBgCanvasWell" Color="{StaticResource ColorBgCanvasWell}" />
    <SolidColorBrush x:Key="BrushBgHeader" Color="{StaticResource ColorBgHeader}" />
    <SolidColorBrush x:Key="BrushBgPanel" Color="{StaticResource ColorBgPanel}" />
    <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}" />
    <SolidColorBrush x:Key="BrushBgInput" Color="{StaticResource ColorBgInput}" />
    <SolidColorBrush x:Key="BrushBgHover" Color="{StaticResource ColorBgHover}" />
    <SolidColorBrush x:Key="BrushBgSelected" Color="{StaticResource ColorBgSelected}" />
    <SolidColorBrush x:Key="BrushBgRaised" Color="{StaticResource ColorBgRaised}" />
    <SolidColorBrush x:Key="BrushBgHud" Color="{StaticResource ColorBgHud}" />
    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BrushBorderStrong" Color="{StaticResource ColorBorderStrong}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="BrushAccentPressed" Color="{StaticResource ColorAccentPressed}" />
    <SolidColorBrush x:Key="BrushAccentSoft" Color="{StaticResource ColorAccentSoft}" />
    <SolidColorBrush x:Key="BrushFocusRing" Color="{StaticResource ColorFocusRing}" />
    <SolidColorBrush x:Key="BrushAccentText" Color="{StaticResource ColorAccentText}" />
    <SolidColorBrush x:Key="BrushStatusOk" Color="{StaticResource ColorStatusOk}" />
    <SolidColorBrush x:Key="BrushStatusOkSoft" Color="{StaticResource ColorStatusOkSoft}" />
    <SolidColorBrush x:Key="BrushStatusWarn" Color="{StaticResource ColorStatusWarn}" />
    <SolidColorBrush x:Key="BrushStatusWarnSoft" Color="{StaticResource ColorStatusWarnSoft}" />
    <SolidColorBrush x:Key="BrushStatusError" Color="{StaticResource ColorStatusError}" />
    <SolidColorBrush x:Key="BrushStatusErrorSoft" Color="{StaticResource ColorStatusErrorSoft}" />
    <SolidColorBrush x:Key="BrushSliderThumb" Color="{StaticResource ColorSliderThumb}" />
    <SolidColorBrush x:Key="BrushRulerBg" Color="#ECECEC" />
    <SolidColorBrush x:Key="BrushRulerTick" Color="#707070" />

</ResourceDictionary>
