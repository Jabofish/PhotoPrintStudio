<Window x:Class="PhotoPrintStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PhotoPrintStudio.App.Controls"
        xmlns:models="clr-namespace:PhotoPrintStudio.Core.Models;assembly=PhotoPrintStudio.Core"
        Title="{Binding WindowTitle, FallbackValue=光影印坊}"
        Icon="pack://application:,,,/PhotoPrintStudio;component/Assets/app_icon.ico"
        Width="1480" Height="900"
        MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource StudioWindow}"
        AllowDrop="True"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        Background="{DynamicResource BrushBgCanvasWell}">

    <Window.Resources>
        <CollectionViewSource x:Key="TemplateGroups" Source="{Binding FilteredTemplates}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Scenario" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <CollectionViewSource x:Key="PrinterGroups" Source="{Binding PrinterChoices}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid KeyboardNavigation.TabNavigation="Cycle"
          Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. 顶栏：文件 / 场景 / 输出 ==================== -->
        <Border Grid.Row="0" Background="{DynamicResource BrushBgHeader}"
                BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：品牌、文件菜单、撤销重做 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/PhotoPrintStudio;component/Assets/app_icon.ico" Width="18" Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="光影印坊" Style="{StaticResource PanelTitle}" Margin="0,0,12,0" />

                    <Button x:Name="FileMenuBtn" Style="{StaticResource GhostButton}" Click="FileMenuBtn_Click"
                            ToolTip="导入照片、打开或保存工程（Alt+F）" AutomationProperties.Name="文件">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolder}" Style="{StaticResource VecIcon}" Margin="0,0,6,0" />
                            <TextBlock Text="文件" VerticalAlignment="Center" />
                            <Path Data="{StaticResource IconChevronDown}" Style="{StaticResource VecIcon}" Width="9" Height="9" Margin="5,1,0,0" />
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource ToolbarDivider}" />

                    <Button Style="{StaticResource IconButton}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"
                            ToolTip="撤销（Ctrl+Z）" AutomationProperties.Name="撤销">
                        <Path Data="{StaticResource IconUndo}" Style="{StaticResource VecIcon}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"
                            ToolTip="重做（Ctrl+Y）" AutomationProperties.Name="重做">
                        <Path Data="{StaticResource IconRedo}" Style="{StaticResource VecIcon}" />
                    </Button>
                </StackPanel>

                <!-- 中：打印场景 -->
                <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle">
                        <RadioButton Style="{StaticResource ScenarioRadioButton}" Click="ScenarioDailyPrint_Click"
                                     IsChecked="{Binding IsDailyPrintScenario, Mode=OneWay}" AutomationProperties.Name="日常打印">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPrint}" Style="{StaticResource VecIcon}" Width="13" Height="13" Margin="0,0,6,0" />
                                <TextBlock Text="日常打印" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ScenarioRadioButton}" Click="ScenarioId_Click"
                                     IsChecked="{Binding ActiveScenario, Converter={StaticResource EnumEquals}, ConverterParameter=IdPhoto, Mode=OneWay}" AutomationProperties.Name="证件照">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconIdPhoto}" Style="{StaticResource VecIcon}" Width="13" Height="13" Margin="0,0,6,0" />
                                <TextBlock Text="证件照" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ScenarioRadioButton}" Click="ScenarioPolaroid_Click"
                                     IsChecked="{Binding ActiveScenario, Converter={StaticResource EnumEquals}, ConverterParameter=Polaroid, Mode=OneWay}" AutomationProperties.Name="拍立得">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPolaroid}" Style="{StaticResource VecIcon}" Width="13" Height="13" Margin="0,0,6,0" />
                                <TextBlock Text="拍立得" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- 右：状态、设置、导出、打印 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="HotFolderPillBtn" Style="{StaticResource GhostButton}" Click="HotFolderWatch_Click"
                            ToolTip="{Binding HotFolderStatusSummary}" AutomationProperties.Name="联机监视">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource BrushTextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHotFolderWatching}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource BrushStatusOk}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding HotFolderBadgeText}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="PreflightPillBtn" Style="{StaticResource GhostButton}" Click="JumpToExportTab_Click"
                            ToolTip="查看印前预检明细" AutomationProperties.Name="印前预检">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="PreflightDot" Width="7" Height="7" Fill="{DynamicResource BrushStatusOk}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="PreflightBadgeText" Text="预检通过" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButton}" Click="Settings_Click" Margin="2,0,0,0"
                            ToolTip="设置（Ctrl+逗号）" AutomationProperties.Name="设置">
                        <Path Data="{StaticResource IconSettings}" Style="{StaticResource VecIcon}" StrokeThickness="1.25" />
                    </Button>

                    <Border Style="{StaticResource ToolbarDivider}" Margin="8,0" />

                    <Button x:Name="ExportMenuButton" Style="{StaticResource ModernButton}" Click="QuickExportMenu_Click" Margin="0,0,8,0"
                            ToolTip="选择导出格式（Ctrl+Shift+E）" AutomationProperties.Name="导出">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconExport}" Style="{StaticResource VecIcon}" Width="13" Height="13" Margin="0,0,6,0" />
                            <TextBlock Text="导出" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding PrintActiveSheetCommand}" Padding="14,4"
                            ToolTip="打印当前页（Ctrl+P）" AutomationProperties.Name="打印">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPrint}" Style="{StaticResource VecIcon}" Width="13" Height="13" Margin="0,0,6,0" />
                            <TextBlock Text="打印" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. 主体：左栏 / 画布 / 右栏 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="284" MinWidth="240" MaxWidth="370" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="460" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="348" MinWidth="305" MaxWidth="460" />
            </Grid.ColumnDefinitions>

            <!-- ========== 左栏：模板与纸张版式 ========== -->
            <Border Grid.Column="0" Background="{DynamicResource BrushBgPanel}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 模板库 -->
                    <DockPanel Grid.Row="0" Margin="12,10,12,8" MaxHeight="360">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button Style="{StaticResource MiniButton}" DockPanel.Dock="Right"
                                    Click="OpenCustomTemplateDialog_Click" ToolTip="调整当前页版式或另存为模板" AutomationProperties.Name="自定义排版">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconLayoutDesign}" Style="{StaticResource VecIcon}" Width="12" Height="12" Margin="0,0,4,0" />
                                    <TextBlock Text="自定义" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="排版模板" Style="{StaticResource PanelTitle}" />
                        </DockPanel>

                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6"
                                   Visibility="{Binding IsDailyPrintScenario, Converter={StaticResource BoolToVis}}">
                            <Button Content="单张照片" ToolTip="跳到单张照片模板"
                                    Click="JumpToTemplateGroup_Click" Tag="{x:Static models:LayoutScenario.SinglePhoto}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveScenario}" Value="{x:Static models:LayoutScenario.SinglePhoto}">
                                                <Setter Property="Background" Value="{DynamicResource BrushBgSelected}" />
                                                <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="六寸二合一" ToolTip="跳到六寸二合一模板"
                                    Click="JumpToTemplateGroup_Click" Tag="{x:Static models:LayoutScenario.SixInchTwoInOne}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveScenario}" Value="{x:Static models:LayoutScenario.SixInchTwoInOne}">
                                                <Setter Property="Background" Value="{DynamicResource BrushBgSelected}" />
                                                <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="自由网格" ToolTip="跳到自由网格模板"
                                    Click="JumpToTemplateGroup_Click" Tag="{x:Static models:LayoutScenario.FreeGrid}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveScenario}" Value="{x:Static models:LayoutScenario.FreeGrid}">
                                                <Setter Property="Background" Value="{DynamicResource BrushBgSelected}" />
                                                <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>

                        <ListBox x:Name="TemplatesList"
                                 ItemsSource="{Binding Source={StaticResource TemplateGroups}}"
                                 SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                                 SelectionChanged="TemplatesList_SelectionChanged"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 AutomationProperties.Name="排版模板"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="2,8,0,6">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GroupLabel}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Name}" Value="{x:Static models:LayoutScenario.SinglePhoto}">
                                                                <Setter Property="Text" Value="单张照片" />
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="{x:Static models:LayoutScenario.SixInchTwoInOne}">
                                                                <Setter Property="Text" Value="六寸二合一" />
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name}" Value="{x:Static models:LayoutScenario.FreeGrid}">
                                                                <Setter Property="Text" Value="自由网格" />
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListItem}">
                                    <Setter Property="Margin" Value="0,0,0,2" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ToolTip>
                                            <StackPanel MaxWidth="280">
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid.ToolTip>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:TemplateGlyphControl Grid.Column="0" Template="{Binding}" Width="38" Height="28" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Converter={StaticResource TemplateListText}}" FontWeight="SemiBold" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Converter={StaticResource TemplateListText}, ConverterParameter=Size}"
                                                       Style="{StaticResource Caption}" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0"
                                                    Visibility="{Binding IsBuiltIn, Converter={StaticResource InverseBoolToVis}}">
                                            <Button Style="{StaticResource IconButtonSmall}" ToolTip="可视化编辑此版式" AutomationProperties.Name="编辑自定义版式"
                                                    Tag="{Binding}" Click="EditTemplate_Click">
                                                <Path Data="{StaticResource IconLayoutDesign}" Style="{StaticResource VecIcon}" Width="12" Height="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonSmall}" ToolTip="重命名模板（F2）" AutomationProperties.Name="重命名模板"
                                                    Tag="{Binding}" Click="RenameTemplate_Click">
                                                <Path Data="{StaticResource IconEdit}" Style="{StaticResource VecIcon}" Width="12" Height="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonSmall}" ToolTip="删除自定义模板" AutomationProperties.Name="删除自定义模板"
                                                    Tag="{Binding}" Click="DeleteTemplate_Click">
                                                <Path Data="{StaticResource IconTrash}" Style="{StaticResource VecIcon}" Width="12" Height="12" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- 纸张与版式：常用项直接可见，出血与输出标记按需展开 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="12,12,12,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveSheet.Slots.Count, StringFormat='本页 {0} 个照片位'}"
                                               Style="{StaticResource Caption}" VerticalAlignment="Center" ToolTip="{Binding AutoPackInfoText}" />
                                    <TextBlock Text="纸张与版式" Style="{StaticResource PanelTitle}" />
                                </DockPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding PaperSizes}" SelectedItem="{Binding SelectedPaper, Mode=TwoWay}"
                                              DisplayMemberPath="Name" AutomationProperties.Name="纸张尺寸" ToolTip="纸张尺寸" />
                                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="4,0,0,0"
                                            ToolTip="新建自定义纸张尺寸（mm）" AutomationProperties.Name="新建自定义纸张" Click="AddCustomPaper_Click">
                                        <Path Data="{StaticResource IconPlus}" Style="{StaticResource VecIcon}" Width="11" Height="11" />
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                            ToolTip="删除当前自定义纸张" AutomationProperties.Name="删除自定义纸张"
                                            Visibility="{Binding IsCustomPaperSelected, Converter={StaticResource BoolToVis}}"
                                            Click="DeleteCustomPaper_Click">
                                        <Path Data="{StaticResource IconTrash}" Style="{StaticResource VecIcon}" Width="12" Height="12" />
                                    </Button>
                                </Grid>

                                <WrapPanel Margin="0,0,0,6">
                                    <CheckBox Content="横向纸张" IsChecked="{Binding IsLandscape}" Margin="0,0,16,0" />
                                    <CheckBox Content="应用到全部页" IsChecked="{Binding ApplySizeToAllPages}"
                                              Visibility="{Binding HasMultiplePages, Converter={StaticResource BoolToVis}}"
                                              ToolTip="改变纸张或日常单张打印尺寸时，更新全部页面并保留照片" />
                                </WrapPanel>

                                <!-- 参数式自动排布控件（自由版式下隐藏，避免覆盖自定义坐标） -->
                                <StackPanel Visibility="{Binding CanEditAutoLayoutSliders, Converter={StaticResource BoolToVis}}">
                                    <!-- 证件照规格 -->
                                    <ComboBox ItemsSource="{Binding IdPhotoSpecs}" SelectedItem="{Binding SelectedIdSpec, Mode=TwoWay}" DisplayMemberPath="Name"
                                              ToolTip="证件照规格" AutomationProperties.Name="证件照规格" Margin="0,0,0,8"
                                              Visibility="{Binding ActiveScenario, Converter={StaticResource EnumToVis}, ConverterParameter=IdPhoto}" />

                                    <!-- 拍立得型号 -->
                                    <StackPanel Visibility="{Binding ActiveScenario, Converter={StaticResource EnumToVis}, ConverterParameter=Polaroid}" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding PolaroidSpecs}" SelectedItem="{Binding SelectedPolaroidSpec, Mode=TwoWay}"
                                                      DisplayMemberPath="Name" ToolTip="拍立得相纸尺寸" AutomationProperties.Name="拍立得相纸尺寸" />
                                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="4,0,0,0"
                                                    ToolTip="新建自定义拍立得尺寸与边框（mm）" AutomationProperties.Name="新建自定义拍立得尺寸" Click="AddCustomPolaroid_Click">
                                                <Path Data="{StaticResource IconPlus}" Style="{StaticResource VecIcon}" Width="11" Height="11" />
                                            </Button>
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                    ToolTip="删除当前自定义拍立得尺寸" AutomationProperties.Name="删除自定义拍立得尺寸"
                                                    Visibility="{Binding IsCustomPolaroidSelected, Converter={StaticResource BoolToVis}}"
                                                    Click="DeleteCustomPolaroid_Click">
                                                <Path Data="{StaticResource IconTrash}" Style="{StaticResource VecIcon}" Width="12" Height="12" />
                                            </Button>
                                        </Grid>
                                        <CheckBox Content="原尺寸放不下时缩为一张" IsChecked="{Binding PolaroidSafeFit}" Margin="0,6,0,0"
                                                  Visibility="{Binding IsAutomaticPolaroidLayout, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <!-- 自由网格行列 -->
                                    <StackPanel Visibility="{Binding CanEditGridSize, Converter={StaticResource BoolToVis}}">
                                        <controls:StudioSliderRow LabelWidth="72" Title="行数" Minimum="1" Maximum="10" Step="1" DefaultValue="{Binding SelectedTemplate.CustomRows, FallbackValue=2}" Value="{Binding CustomGridRows}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                        <controls:StudioSliderRow LabelWidth="72" Title="列数" Minimum="1" Maximum="10" Step="1" DefaultValue="{Binding SelectedTemplate.CustomCols, FallbackValue=2}" Value="{Binding CustomGridCols}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                    </StackPanel>

                                    <controls:StudioSliderRow LabelWidth="72" Title="外边距 mm" Minimum="0" Maximum="25" Step="0.5" DefaultValue="{Binding SelectedTemplate.DefaultMarginMm, FallbackValue=5}" ValueFormat="0.0" Value="{Binding LayoutMarginMm}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                    <controls:StudioSliderRow LabelWidth="72" Title="格间距 mm" Minimum="0" Maximum="20" Step="0.5" DefaultValue="{Binding SelectedTemplate.DefaultGapMm, FallbackValue=4}" ValueFormat="0.0" Value="{Binding LayoutGapMm}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted"
                                                              Visibility="{Binding IsSinglePhotoLayout, Converter={StaticResource InverseBoolToVis}}" />

                                </StackPanel>

                                <Grid Margin="0,2,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="裁切标记" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding CropMarkStyles}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                              SelectedValue="{Binding SelectedCropMarkStyle, Mode=TwoWay}" AutomationProperties.Name="输出裁切标记"
                                              ToolTip="输出裁切标记：会写入导出文件和打印成品。白底裁切角标在照片角落外侧标出切点。" />
                                </Grid>

                                <Expander Header="出血与输出标记" Style="{StaticResource StudioExpander}" IsExpanded="False">
                                    <StackPanel>
                                        <StackPanel Visibility="{Binding CanEditAutoLayoutSliders, Converter={StaticResource BoolToVis}}">
                                            <controls:StudioSliderRow LabelWidth="72" Title="出血 mm" Minimum="0" Maximum="3" Step="0.5" DefaultValue="{Binding SelectedTemplate.DefaultBleedMm, FallbackValue=0}" ValueFormat="0.0" Value="{Binding LayoutBleedMm}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                            <CheckBox Content="贴纸边排布" Margin="0,4,0,0" ToolTip="让版式贴近纸边，减少外边裁切"
                                                      IsChecked="{Binding AlignFlushToEdge, Mode=TwoWay}"
                                                      Visibility="{Binding IsSinglePhotoLayout, Converter={StaticResource InverseBoolToVis}}" />
                                        </StackPanel>
                                        <CheckBox Content="输出中线标记" IsChecked="{Binding ShowCenterFoldTick}" Margin="0,4,0,8"
                                                  ToolTip="在纸张中线处输出折线短标记，会写入导出文件和打印成品" />
                                        <Button Style="{StaticResource ModernButton}" Content="清除边距"
                                                Command="{Binding OneClickRemoveBordersCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                                Visibility="{Binding CanEditAutoLayoutSliders, Converter={StaticResource BoolToVis}}"
                                                ToolTip="将外边距、格间距和出血归零，并紧贴纸张左上边排布（Ctrl+Z 可撤销）" />
                                        <Button Content="关闭本页所有输出标记" Style="{StaticResource ModernButton}" HorizontalAlignment="Stretch"
                                                Command="{Binding ClearOutputMarksCommand}" ToolTip="关闭裁切标记、中线标记与页脚测试条" />
                                    </StackPanel>
                                </Expander>

                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter x:Name="LeftPaneSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BrushBgPanel}" Cursor="SizeWE" AutomationProperties.Name="调整左栏宽度" />

            <!-- ========== 中栏：工具栏、当前对象、画布、底栏 ========== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="6" />
                    <RowDefinition x:Name="AssetTrayRow" Height="150" MinHeight="48" MaxHeight="340" />
                </Grid.RowDefinitions>

                <!-- 1) 画布工具栏：视图 | 照片工具 | 预览与缩放 -->
                <Border x:Name="CanvasToolbar" Grid.Row="0" Background="{DynamicResource BrushBgPanel}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="10,3" MinHeight="38">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource PillToggleButton}" Padding="8,2" MinHeight="24"
                                                  IsChecked="{Binding ViewMode, Converter={StaticResource EnumEquals}, ConverterParameter=SheetOverview, Mode=OneWay}"
                                                  Click="ViewModeSheet_Click" ToolTip="排版总览（画布中按 G）" AutomationProperties.Name="排版总览">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconGrid}" Style="{StaticResource VecIcon}" Width="12" Height="12" />
                                            <TextBlock Text="排版总览" Margin="5,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding ActualWidth, ElementName=CanvasToolbar, Converter={StaticResource CanvasToolbarLabelVisibility}}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource PillToggleButton}" Padding="8,2" MinHeight="24"
                                                  IsEnabled="{Binding HasSelectedAsset}"
                                                  IsChecked="{Binding ViewMode, Converter={StaticResource EnumEquals}, ConverterParameter=SingleRetouchCrop, Mode=OneWay}"
                                                  Click="ViewModeSingle_Click" ToolTip="单图裁剪（画布中按 R）" AutomationProperties.Name="单图裁剪">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCrop}" Style="{StaticResource VecIcon}" Width="12" Height="12" />
                                            <TextBlock Text="单图裁剪" Margin="5,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding ActualWidth, ElementName=CanvasToolbar, Converter={StaticResource CanvasToolbarLabelVisibility}}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton Style="{StaticResource PillToggleButton}" Padding="8,2" MinHeight="24"
                                                  IsEnabled="{Binding HasSelectedAsset}"
                                                  IsChecked="{Binding ViewMode, Converter={StaticResource EnumEquals}, ConverterParameter=SplitCompare, Mode=OneWay}"
                                                  Click="ViewModeSplit_Click" ToolTip="分屏对比（画布中按 Y）" AutomationProperties.Name="分屏对比">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCompare}" Style="{StaticResource VecIcon}" Width="12" Height="12" />
                                            <TextBlock Text="分屏对比" Margin="5,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding ActualWidth, ElementName=CanvasToolbar, Converter={StaticResource CanvasToolbarLabelVisibility}}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                        </StackPanel>
                                    </ToggleButton>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ToolbarDivider}" Margin="8,0" />

                            <Button x:Name="HoldCompareBtn" Style="{StaticResource IconButton}"
                                    IsEnabled="{Binding HasSelectedAsset}"
                                    ToolTip="按住查看原图（画布中按住空格）" AutomationProperties.Name="按住对比原图"
                                    PreviewMouseLeftButtonDown="HoldCompareBtn_Down"
                                    PreviewMouseLeftButtonUp="HoldCompareBtn_Up"
                                    MouseLeave="HoldCompareBtn_Leave">
                                <Path Data="{StaticResource IconEye}" Style="{StaticResource VecIcon}" />
                            </Button>

                            <ToggleButton Style="{StaticResource IconToggleButton}" Margin="2,0,0,0"
                                          IsEnabled="{Binding HasSelectedAsset}"
                                          ToolTip="两点拉直：依次点击水平线两端（画布中按 Shift+T）" AutomationProperties.Name="两点拉直"
                                          IsChecked="{Binding IsTwoPointStraightenActive, Mode=OneWay}"
                                          Command="{Binding ToggleTwoPointStraightenCommand}">
                                <Path Data="{StaticResource IconStraighten}" Style="{StaticResource VecIcon}" />
                            </ToggleButton>

                            <ToggleButton Style="{StaticResource IconToggleButton}" Margin="2,0,0,0"
                                          IsEnabled="{Binding HasSelectedAsset}"
                                          IsChecked="{Binding EditStudioPortraitEnhance, Mode=OneWay}"
                                          Command="{Binding ToggleStudioPortraitEnhanceCommand}"
                                          AutomationProperties.Name="{Binding StudioEnhanceActionText}">
                                <ToggleButton.ToolTip>
                                    <TextBlock>
                                        <Run Text="{Binding StudioEnhanceActionText, Mode=OneWay}" FontWeight="SemiBold" /><LineBreak />
                                        <Run Text="自动校正白平衡、均衡脸部光线并优化肤质，再次点击关闭" />
                                    </TextBlock>
                                </ToggleButton.ToolTip>
                                <Path Data="{StaticResource IconSparkle}" Style="{StaticResource VecIcon}" />
                            </ToggleButton>

                            <Button Style="{StaticResource GhostButton}" Margin="2,0,0,0" Padding="7,0"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="按格位比例优化当前照片构图；证件照需加载人脸模型，计算中可取消，完成后可还原"
                                    IsEnabled="{Binding CanAutoFramePhoto}"
                                    Command="{Binding AutoFrameWithFaceCommand}"
                                    AutomationProperties.Name="{Binding AutoFrameActionText}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFaceDetect}" Style="{StaticResource VecIcon}" />
                                    <TextBlock Text="{Binding AutoFrameActionText}" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding ActualWidth, ElementName=CanvasToolbar, Converter={StaticResource CanvasToolbarLabelVisibility}}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Button Style="{StaticResource IconButton}" Click="PreviewSettings_Click"
                                    ToolTip="预览设置：标尺、参考线、溢出提示（Ctrl+Shift+逗号）" AutomationProperties.Name="预览设置">
                                <Path Data="{StaticResource IconOverlay}" Style="{StaticResource VecIcon}" />
                            </Button>

                            <Border Style="{StaticResource ToolbarDivider}" />

                            <Button Style="{StaticResource IconButton}" Click="ZoomOut_Click" ToolTip="缩小（Ctrl+-）" AutomationProperties.Name="缩小画布">
                                <Path Data="{StaticResource IconMinus}" Style="{StaticResource VecIcon}" Width="16" Height="16" Stretch="None" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="ZoomFit_Click" Padding="4,2" MinWidth="48"
                                    AutomationProperties.Name="适应窗口" ToolTip="适应窗口（Ctrl+0）">
                                <TextBlock x:Name="ZoomPercentText" Text="适应" FontSize="11.5" TextAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Click="ZoomIn_Click" ToolTip="放大（Ctrl+=）" AutomationProperties.Name="放大画布">
                                <Path Data="{StaticResource IconPlus}" Style="{StaticResource VecIcon}" Width="16" Height="16" Stretch="None" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2) 当前对象条 + 工具提示条 -->
                <StackPanel Grid.Row="1">
                    <Border Background="{DynamicResource BrushBgHeader}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="12,3" MinHeight="34">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource BrushAccent}"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ActiveEditTargetTitle}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ActiveEditTargetTitle}" />
                                <TextBlock Grid.Column="2" Text="{Binding ActiveEditTargetMeta}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11.5"
                                           Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ActiveEditTargetMeta}" />
                            </Grid>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Button Content="放入当前格位" Style="{StaticResource PrimaryButton}" Padding="10,2" MinHeight="24" Margin="0,0,6,0"
                                        Visibility="{Binding IsEditingUnassignedAsset, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding AssignSelectedAssetToSelectedSlotCommand}" />
                                <Button Content="拆分独立微调" Style="{StaticResource ModernButton}" Padding="10,2" MinHeight="24" Margin="0,0,6,0"
                                        ToolTip="为当前格位创建独立照片副本，之后的调色或裁剪不再同步到其他格位"
                                        Visibility="{Binding CanForkIndependentAsset, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding ForkIndependentAssetForSelectedSlotCommand}" />
                                <StackPanel Orientation="Horizontal" Visibility="{Binding HasSelectedAsset, Converter={StaticResource BoolToVis}}">
                                    <Button Style="{StaticResource IconButtonSmall}" ToolTip="逆时针旋转 90°（Ctrl+[）" AutomationProperties.Name="逆时针旋转 90 度" Command="{Binding RotateQuarterLeftCommand}">
                                        <Path Data="{StaticResource IconRotateLeft}" Style="{StaticResource VecIcon}" Width="13" Height="13" />
                                    </Button>
                                    <Button Style="{StaticResource IconButtonSmall}" ToolTip="顺时针旋转 90°（Ctrl+]）" AutomationProperties.Name="顺时针旋转 90 度" Command="{Binding RotateQuarterRightCommand}">
                                        <Path Data="{StaticResource IconRotateRight}" Style="{StaticResource VecIcon}" Width="13" Height="13" />
                                    </Button>
                                    <Button Style="{StaticResource IconButtonSmall}" ToolTip="水平镜像" AutomationProperties.Name="水平镜像" Command="{Binding ToggleFlipHorizontalCommand}">
                                        <Path Data="{StaticResource IconFlipH}" Style="{StaticResource VecIcon}" Width="13" Height="13" />
                                    </Button>
                                    <Button Style="{StaticResource IconButtonSmall}" ToolTip="清空当前格位（Delete）" AutomationProperties.Name="清空当前格位" Command="{Binding ClearSelectedSlotCommand}"
                                            Visibility="{Binding HasSelectedSlotPhoto, Converter={StaticResource BoolToVis}}">
                                        <Path Data="{StaticResource IconTrash}" Style="{StaticResource VecIcon}" Width="13" Height="13" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 工具提示条（裁剪、对比、两点拉直时显示） -->
                    <Border Background="{DynamicResource BrushAccentSoft}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="0,0,0,1" Padding="12,3"
                            Visibility="{Binding HasActiveToolBanner, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button Content="返回排版总览" Style="{StaticResource MiniButton}" DockPanel.Dock="Right"
                                    Click="ViewModeSheet_Click" ToolTip="返回排版总览（Esc / G）"
                                    Visibility="{Binding IsHoldingCompare, Converter={StaticResource InverseBoolToVis}}" />
                            <TextBlock Text="{Binding ActiveToolBannerText}" Foreground="{DynamicResource BrushAccent}" FontSize="11.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- 3) 标尺与画布 -->
                <Grid Grid.Row="2" x:Name="ViewportHost" Focusable="True" SizeChanged="ViewportHost_SizeChanged"
                      PreviewMouseWheel="ViewportHost_PreviewMouseWheel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="RulerCornerBox" Grid.Row="0" Grid.Column="0" Width="22" Height="22"
                            Background="{DynamicResource BrushRulerBg}"
                            BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,1,1"
                            Visibility="{Binding ShowRulers, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="mm" FontSize="8.5" Foreground="{DynamicResource BrushTextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <controls:PhysicalRulerControl x:Name="TopRuler" Grid.Row="0" Grid.Column="1" Height="22"
                                                   IsVertical="False"
                                                   Visibility="{Binding ShowRulers, Converter={StaticResource BoolToVis}}" />

                    <controls:PhysicalRulerControl x:Name="LeftRuler" Grid.Row="1" Grid.Column="0" Width="22"
                                                   IsVertical="True"
                                                   Visibility="{Binding ShowRulers, Converter={StaticResource BoolToVis}}" />

                    <ScrollViewer x:Name="CanvasScroller" Grid.Row="1" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="{DynamicResource BrushBgCanvasWell}"
                                  PreviewMouseDown="CanvasScroller_PreviewMouseDown"
                                  PreviewMouseMove="CanvasScroller_PreviewMouseMove"
                                  PreviewMouseUp="CanvasScroller_PreviewMouseUp"
                                  LostMouseCapture="CanvasScroller_LostMouseCapture"
                                  ScrollChanged="CanvasScroller_ScrollChanged">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="26">
                            <Border x:Name="PaperShadowBorder" Background="White" CornerRadius="2"
                                    UseLayoutRounding="True" SnapsToDevicePixels="True"
                                    AllowDrop="True" DragOver="CanvasImage_DragOver" DragLeave="CanvasImage_DragLeave" Drop="CanvasImage_Drop">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="5" Opacity="0.38" />
                                </Border.Effect>
                                <Grid>
                                    <Image x:Name="CanvasPreviewImage"
                                           Source="{Binding CanvasPreviewBitmap}"
                                           Stretch="Fill"
                                           UseLayoutRounding="True"
                                           SnapsToDevicePixels="True"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           MouseLeftButtonDown="CanvasPreviewImage_MouseLeftButtonDown"
                                           MouseMove="CanvasPreviewImage_MouseMove"
                                           MouseLeave="CanvasPreviewImage_MouseLeave"
                                           LostMouseCapture="CanvasPreviewImage_LostMouseCapture"
                                           MouseLeftButtonUp="CanvasPreviewImage_MouseLeftButtonUp"
                                           ContextMenuOpening="CanvasPreviewImage_ContextMenuOpening">
                                        <Image.ContextMenu>
                                            <ContextMenu />
                                        </Image.ContextMenu>
                                    </Image>
                                    <Canvas x:Name="OverlayMarksCanvas" IsHitTestVisible="False" />
                                </Grid>
                            </Border>

                            <!-- 空工程引导 -->
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
                                    Background="{DynamicResource BrushBgHud}"
                                    BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1"
                                    CornerRadius="5" Padding="14,9"
                                    Visibility="{Binding Assets.Count, Converter={StaticResource IntZeroToVis}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="把照片拖到这里，或" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,10,0" />
                                    <Button Content="选择本地照片" Style="{StaticResource PrimaryButton}" Click="ImportPhotos_Click" Margin="0,0,6,0" ToolTip="Ctrl+O" />
                                    <Button Content="载入测试样片" Style="{StaticResource ModernButton}" Command="{Binding LoadSamplePhotosCommand}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <!-- 操作反馈提示 -->
                    <Border Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14"
                            Background="{DynamicResource BrushBgHud}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1"
                            CornerRadius="4" Padding="14,7" IsHitTestVisible="False"
                            Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.3" />
                        </Border.Effect>
                        <TextBlock Text="{Binding ToastMessage}" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" />
                    </Border>
                </Grid>

                <!-- 4) 底栏：照片素材池 / 打印页面 + 翻页 -->
                <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Background="{DynamicResource BrushBorderSubtle}"
                              ToolTip="拖动调整底栏高度" AutomationProperties.Name="调整底栏高度" />
                <Border Grid.Row="4" Background="{DynamicResource BrushBgPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource BrushBgHeader}" BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="0,0,0,1" Padding="8,4" SizeChanged="AssetToolbar_SizeChanged">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource SegmentHost}">
                                        <StackPanel Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle">
                                            <RadioButton x:Name="PhotosTrayTab"
                                                         Style="{StaticResource SegmentRadio}" IsChecked="True"
                                                         GroupName="TrayView" Click="TrayPhotos_Click" AutomationProperties.Name="照片素材">
                                                <RadioButton.ToolTip>
                                                    <TextBlock>
                                                        <Run Text="照片素材（Alt+6）。已导入 " /><Run Text="{Binding Assets.Count, Mode=OneWay}" />
                                                        <Run Text=" 张，其中 " /><Run Text="{Binding UnplacedPhotoCount, Mode=OneWay}" /><Run Text=" 张未排版" />
                                                    </TextBlock>
                                                </RadioButton.ToolTip>
                                                <TextBlock Text="{Binding Assets.Count, StringFormat='照片 {0}'}"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                            </RadioButton>
                                            <RadioButton x:Name="PagesTrayTab" Style="{StaticResource SegmentRadio}"
                                                         GroupName="TrayView" Click="TrayPages_Click" ToolTip="查看打印页面（Alt+7）" AutomationProperties.Name="打印页面">
                                                <TextBlock Text="{Binding Sheets.Count, StringFormat='页面 {0}'}"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                            </RadioButton>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel x:Name="AssetActions" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <Button Style="{StaticResource IconButton}" Width="32" Height="34" Click="ImportPhotos_Click"
                                                ToolTip="导入照片（Ctrl+O）" AutomationProperties.Name="导入照片">
                                            <Path Data="{StaticResource IconPlus}" Style="{StaticResource VecIcon}" />
                                        </Button>
                                        <Button x:Name="SelectedPhotosButton" Content="已选 0 张" Style="{StaticResource GhostButton}" Padding="4,0"
                                                MinHeight="34" Click="SelectedPhotos_Click" IsEnabled="False" Visibility="Collapsed"
                                                ToolTip="排版或移除所选照片（Ctrl+Enter）" />
                                        <Button Style="{StaticResource IconButton}" Width="32" Height="34" Click="AssetMore_Click"
                                                ToolTip="更多照片操作" AutomationProperties.Name="更多照片操作">
                                            <Path Data="{StaticResource IconMore}" Style="{StaticResource VecIcon}" StrokeThickness="2.4" Width="16" Height="16" Stretch="None" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel x:Name="PageActions" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed">
                                        <Button Style="{StaticResource IconButton}" Width="32" Height="34" Command="{Binding AddBlankSheetCommand}"
                                                ToolTip="新增空白页（Ctrl+Shift+N）" AutomationProperties.Name="新增空白页">
                                            <Path Data="{StaticResource IconPlus}" Style="{StaticResource VecIcon}" />
                                        </Button>
                                        <Button x:Name="SelectedPagesButton" Content="已选 0 页" Style="{StaticResource GhostButton}" Padding="4,0"
                                                MinHeight="34" Click="SelectedPages_Click" IsEnabled="False" Visibility="Collapsed"
                                                ToolTip="清空或删除所选页面" />
                                    </StackPanel>
                                </StackPanel>

                                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="6,0,4,0">
                                    <Button HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Click="SelectUnplacedPhotos_Click" ToolTip="点击选中全部未排版照片">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MiniButton}">
                                                <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UnplacedPhotoCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Visibility, ElementName=AssetActions}" Value="Collapsed">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding UnplacedPhotoCount, StringFormat='未排版 {0} 张'}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </Grid>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <Button Command="{Binding PrevSheetCommand}" IsEnabled="{Binding CanGoToPreviousPage}"
                                            AutomationProperties.Name="上一页">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PagerArrowButton}">
                                                <Setter Property="ToolTip" Value="上一页（Page Up，画布中按 ←）" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="ToolTip" Value="已是第一页" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Path Data="{StaticResource IconChevronLeft}" Style="{StaticResource VecIcon}" />
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}" Padding="5,4" MinWidth="66" MinHeight="36" Click="JumpToPage_Click"
                                            IsEnabled="{Binding HasMultiplePages}" ToolTip="跳转到指定页（Ctrl+G）" AutomationProperties.Name="跳转页码">
                                        <TextBlock Typography.NumeralAlignment="Tabular"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="第{0}/{1}页">
                                                    <Binding Path="CurrentPageNumber" />
                                                    <Binding Path="Sheets.Count" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Button>
                                    <Button Command="{Binding NextSheetCommand}" IsEnabled="{Binding CanGoToNextPage}"
                                            AutomationProperties.Name="下一页">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PagerArrowButton}">
                                                <Setter Property="ToolTip" Value="下一页（Page Down，画布中按 →）" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="ToolTip" Value="已是最后一页" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Path Data="{StaticResource IconChevronRight}" Style="{StaticResource VecIcon}" />
                                    </Button>
                                    <Border Style="{StaticResource ToolbarDivider}" Margin="3,0" />
                                    <Button Style="{StaticResource IconButton}" Width="34" Height="36" Click="PageMore_Click"
                                            AutomationProperties.Name="页面操作" ToolTip="页面操作：新增、复制、删除或重新分页">
                                        <Path Data="{StaticResource IconLayers}" Style="{StaticResource VecIcon}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid x:Name="TrayContent" Grid.Row="1">
                        <controls:AssetTrayListBox x:Name="AssetsList"
                                 ItemsSource="{Binding Assets}"
                                 SelectionMode="Extended"
                                 SelectionChanged="AssetsList_SelectionChanged"
                                 MouseDoubleClick="AssetsList_MouseDoubleClick"
                                 ContextMenuOpening="AssetsList_ContextMenuOpening"
                                 PreviewMouseWheel="AssetsList_PreviewMouseWheel"
                                 PreviewMouseLeftButtonDown="AssetsList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="AssetsList_PreviewMouseMove"
                                 PreviewMouseLeftButtonUp="AssetsList_PreviewMouseLeftButtonUp"
                                 PreviewMouseRightButtonDown="AssetsList_PreviewMouseRightButtonDown"
                                 LostMouseCapture="AssetsList_LostMouseCapture"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 Background="Transparent" BorderThickness="0" Padding="8,6"
                                 AutomationProperties.Name="照片素材池"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ContextMenu>
                                <ContextMenu />
                            </ListBox.ContextMenu>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListItem}">
                                    <Setter Property="Padding" Value="5" />
                                    <Setter Property="Width" Value="196" />
                                    <Setter Property="Margin" Value="0,0,8,0" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ToolTip>
                                            <TextBlock>
                                                <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" /><LineBreak />
                                                <Run Text="双击快速放入格位；拖动可批量放入；右键更多操作" />
                                            </TextBlock>
                                        </Grid.ToolTip>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="62" Height="62" CornerRadius="5" ClipToBounds="True"
                                                Background="{DynamicResource BrushBgInput}">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3"
                                                        CornerRadius="3" Padding="4,0" ToolTip="已放入的格位数">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#B81E293B" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPlaced}" Value="True">
                                                                    <Setter Property="Background" Value="#CC2563EB" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding UsageBadgeText}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ResolutionText}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding MetaText}" Foreground="{DynamicResource BrushTextMuted}" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </controls:AssetTrayListBox>
                        <controls:AssetTrayListBox x:Name="PagePreviewList" Visibility="Collapsed" ItemsSource="{Binding Sheets}"
                                 SelectionMode="Extended" SelectionChanged="PagePreviewList_SelectionChanged"
                                 ContextMenuOpening="PagePreviewList_ContextMenuOpening"
                                 PreviewMouseLeftButtonDown="PagePreviewList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="PagePreviewList_PreviewMouseMove"
                                 PreviewMouseLeftButtonUp="PagePreviewList_PreviewMouseLeftButtonUp"
                                 PreviewMouseRightButtonDown="PagePreviewList_PreviewMouseRightButtonDown"
                                 LostMouseCapture="PagePreviewList_LostMouseCapture" PreviewMouseWheel="TrayList_PreviewMouseWheel"
                                 Background="Transparent" BorderThickness="0" Padding="8,6"
                                 AutomationProperties.Name="打印页面"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="0">
                            <ListBox.ContextMenu>
                                <ContextMenu />
                            </ListBox.ContextMenu>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListItem}">
                                    <Setter Property="Padding" Value="4" />
                                    <Setter Property="Margin" Value="0,0,8,0" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding SheetName}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="132" MinHeight="68" ToolTip="点击查看排版，右键调整顺序或清空，拖动框选，Delete 删除">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{DynamicResource BrushBgInput}" CornerRadius="4" ClipToBounds="True">
                                            <Image Stretch="Uniform" MaxHeight="180" Loaded="PagePreviewImage_Loaded" Unloaded="PagePreviewImage_Unloaded" />
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding SheetName}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,4,0,0"
                                                   Loaded="PagePreviewLabel_Loaded" Unloaded="PagePreviewLabel_Unloaded" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </controls:AssetTrayListBox>
                        <Canvas x:Name="TraySelectionCanvas" IsHitTestVisible="False" ClipToBounds="True">
                            <Rectangle x:Name="TraySelectionRect" Visibility="Collapsed" Stroke="{DynamicResource BrushAccent}"
                                       StrokeThickness="1" StrokeDashArray="4,3" />
                        </Canvas>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter x:Name="RightPaneSplitter" Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BrushBgPanel}" Cursor="SizeWE" AutomationProperties.Name="调整右栏宽度" />

            <!-- ========== 右栏：调色 / 卡片 / 输出 ========== -->
            <Border x:Name="RightInspector" Grid.Column="4" Background="{DynamicResource BrushBgPanel}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1,0,0,0">
                <TabControl Style="{StaticResource StudioTabControl}" SelectedIndex="{Binding RightTabIndex, Mode=TwoWay}">

                    <!-- ==================== TAB 1：调色修图 ==================== -->
                    <TabItem Header="调色修图" Style="{StaticResource StudioTabItem}" ToolTip="Alt+1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 固定顶部：直方图、参数复制、预设、二级页签 -->
                            <StackPanel Grid.Row="0" Margin="12,0,12,4">
                                <controls:HistogramControl x:Name="HistogramCtrl" Height="62" Histogram="{Binding ActiveHistogram}" Margin="0,0,0,4" />

                                <DockPanel Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Style="{StaticResource IconButtonSmall}" ToolTip="复制调色参数（Ctrl+C）" AutomationProperties.Name="复制调色参数" Command="{Binding CopyColorParametersCommand}" IsEnabled="{Binding HasSelectedAsset}">
                                            <Path Data="{StaticResource IconCopy}" Style="{StaticResource VecIcon}" Width="12" Height="12" />
                                        </Button>
                                        <Button Style="{StaticResource IconButtonSmall}" ToolTip="粘贴到此照片（Ctrl+V）" AutomationProperties.Name="粘贴调色参数到此照片" Command="{Binding PasteColorToSelectedCommand}" IsEnabled="{Binding CanPasteColorToSelected}">
                                            <Path Data="{StaticResource IconPaste}" Style="{StaticResource VecIcon}" Width="12" Height="12" />
                                        </Button>
                                        <Button Content="粘贴全部" Style="{StaticResource MiniButton}" ToolTip="将复制的调色参数粘贴到全部照片" Command="{Binding PasteColorToAllAssetsCommand}" IsEnabled="{Binding CanPasteColorToAll}" />
                                        <Button Content="全部重置" Style="{StaticResource MiniButton}" ToolTip="重置当前照片的全部调色参数" Command="{Binding ResetColorAdjustmentsCommand}" IsEnabled="{Binding HasAnyColorEdits}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ClippingWarningText}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ClippingWarningText}" />
                                </DockPanel>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <ComboBox x:Name="ColorPresetCombo" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" DisplayMemberPath="Name"
                                                  IsEnabled="{Binding HasSelectedAsset}"
                                                  ToolTip="调色预设。选中自定义预设后可按 F2 重命名。" AutomationProperties.Name="调色预设" />
                                        <TextBlock Text="自定义调色" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,26,0"
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontStyle="Italic"
                                                   Visibility="{Binding ShowCustomPresetPlaceholder, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <Button Grid.Column="1" Content="存为预设" Style="{StaticResource ModernButton}" Margin="6,0,0,0" Click="SaveCustomPreset_Click"
                                            IsEnabled="{Binding HasSelectedAsset}"
                                            ToolTip="把当前照片的调色参数存为预设" />
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="2,0,0,0"
                                            ToolTip="重命名当前预设（F2）" AutomationProperties.Name="重命名当前预设"
                                            Visibility="{Binding IsCustomPresetSelected, Converter={StaticResource BoolToVis}}"
                                            Click="RenamePreset_Click">
                                        <Path Data="{StaticResource IconEdit}" Style="{StaticResource VecIcon}" Width="12" Height="12" />
                                    </Button>
                                    <Button Grid.Column="3" Style="{StaticResource IconButton}"
                                            ToolTip="删除当前预设" AutomationProperties.Name="删除当前预设"
                                            Visibility="{Binding IsCustomPresetSelected, Converter={StaticResource BoolToVis}}"
                                            Click="DeletePreset_Click">
                                        <Path Data="{StaticResource IconTrash}" Style="{StaticResource VecIcon}" Width="12" Height="12" />
                                    </Button>
                                </Grid>

                                <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                                    <UniformGrid Rows="1" KeyboardNavigation.DirectionalNavigation="Cycle">
                                        <RadioButton Style="{StaticResource SubSegmentRadio}" ToolTip="Alt+Shift+1" AutomationProperties.Name="光影与色彩"
                                                     IsChecked="{Binding ColorSubTabIndex, Converter={StaticResource IntEquals}, ConverterParameter=0, Mode=TwoWay}">
                                            <Grid>
                                                <TextBlock Text="光影与色彩" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                                <Canvas Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <Ellipse Width="5" Height="5" Canvas.Left="3" Canvas.Top="-2" Fill="{DynamicResource BrushAccent}"
                                                             Visibility="{Binding HasLightColorEdits, Converter={StaticResource BoolToVis}}" />
                                                </Canvas>
                                            </Grid>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource SubSegmentRadio}" ToolTip="Alt+Shift+2" AutomationProperties.Name="曲线与分色"
                                                     IsChecked="{Binding ColorSubTabIndex, Converter={StaticResource IntEquals}, ConverterParameter=1, Mode=TwoWay}">
                                            <Grid>
                                                <TextBlock Text="曲线与分色" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                                <Canvas Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <Ellipse Width="5" Height="5" Canvas.Left="3" Canvas.Top="-2" Fill="{DynamicResource BrushAccent}"
                                                             Visibility="{Binding HasCurveHslEdits, Converter={StaticResource BoolToVis}}" />
                                                </Canvas>
                                            </Grid>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource SubSegmentRadio}" ToolTip="Alt+Shift+3" AutomationProperties.Name="裁剪与人像"
                                                     IsChecked="{Binding ColorSubTabIndex, Converter={StaticResource IntEquals}, ConverterParameter=2, Mode=TwoWay}">
                                            <Grid>
                                                <TextBlock Text="裁剪与人像" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                                <Canvas Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <Ellipse Width="5" Height="5" Canvas.Left="3" Canvas.Top="-2" Fill="{DynamicResource BrushAccent}"
                                                             Visibility="{Binding HasCropPortraitEdits, Converter={StaticResource BoolToVis}}" />
                                                </Canvas>
                                            </Grid>
                                        </RadioButton>
                                    </UniformGrid>
                                </Border>
                            </StackPanel>

                            <!-- 子页内容区 -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,0,12,14">
                                <Grid>
                                    <!-- 子页 0：光影与色彩 -->
                                    <StackPanel IsEnabled="{Binding HasSelectedAsset}" Visibility="{Binding ColorSubTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=0}">
                                        <Border Style="{StaticResource PanelCard}">
                                            <StackPanel>
                                                <DockPanel Style="{StaticResource CardHeader}">
                                                    <Button Content="重置" Style="{StaticResource MiniButton}" DockPanel.Dock="Right" Command="{Binding ResetLightingGroupCommand}" IsEnabled="{Binding HasLightingGroupEdits}" ToolTip="重置「光影」参数" />
                                                    <TextBlock Text="光影" Style="{StaticResource CardTitle}" />
                                                </DockPanel>
                                                <controls:StudioSliderRow Title="曝光 (EV)" Minimum="-2.0" Maximum="2.0" Step="0.05" DefaultValue="0" ValueFormat="0.00" Value="{Binding EditExposure}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <controls:StudioSliderRow Title="亮度" Minimum="-100" Maximum="100" Step="1" DefaultValue="0" Value="{Binding EditBrightness}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <controls:StudioSliderRow Title="对比度" Minimum="-100" Maximum="100" Step="1" DefaultValue="0" Value="{Binding EditContrast}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <controls:StudioSliderRow Title="高光恢复" Minimum="-100" Maximum="100" Step="1" DefaultValue="0" Value="{Binding EditHighlights}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <controls:StudioSliderRow Title="阴影提亮" Minimum="-100" Maximum="100" Step="1" DefaultValue="0" Value="{Binding EditShadows}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <controls:StudioSliderRow Title="白色色阶" Minimum="-100" Maximum="100" Step="1" DefaultValue="0" Value="{Binding EditWhites}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <controls:StudioSliderRow Title="黑色色阶" Minimum="-100" Maximum="100" Step="1" DefaultValue="0" Value="{Binding EditBlacks}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <controls:StudioSliderRow Title="中间调 Gamma" Minimum="0.50" Maximum="1.80" Step="0.02" DefaultValue="1.00" ValueFormat="0.00" Value="{Binding EditGamma}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource PanelCard}" BorderThickness="0">
                                            <StackPanel>
                                                <DockPanel Style="{StaticResource CardHeader}">
                                                    <Button Content="重置" Style="{StaticResource MiniButton}" DockPanel.Dock="Right" Command="{Binding ResetWhiteBalanceGroupCommand}" IsEnabled="{Binding HasColorFilterGroupEdits}" ToolTip="重置「色彩与滤镜」参数" />
                                                    <TextBlock Text="色彩与滤镜" Style="{StaticResource CardTitle}" />
                                                </DockPanel>
                                                <controls:StudioSliderRow Title="色温 (冷↔暖)" Minimum="-100" Maximum="100" Step="1" DefaultValue="0" Value="{Binding EditTemperature}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <controls:StudioSliderRow Title="色调 (绿↔品)" Minimum="-100" Maximum="100" Step="1" DefaultValue="0" Value="{Binding EditTint}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <controls:StudioSliderRow Title="自然饱和度" Minimum="-100" Maximum="100" Step="1" DefaultValue="0" Value="{Binding EditVibrance}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <controls:StudioSliderRow Title="全局饱和度" Minimum="-100" Maximum="100" Step="1" DefaultValue="0" Value="{Binding EditSaturation}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <Grid Margin="0,6,0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="色调滤镜" Style="{StaticResource FieldLabel}" />
                                                    <ComboBox Grid.Column="1" SelectedValue="{Binding EditFilterId, Mode=TwoWay}" SelectedValuePath="Tag" AutomationProperties.Name="色调滤镜">
                                                        <ComboBoxItem Content="无滤镜（原色）" Tag="none" />
                                                        <ComboBoxItem Content="富士日系清透" Tag="fuji_fresh" />
                                                        <ComboBoxItem Content="柯达复古暖调" Tag="kodak_warm" />
                                                        <ComboBoxItem Content="复古褪色胶片" Tag="vintage_fade" />
                                                        <ComboBoxItem Content="银盐高反差黑白" Tag="bw_silver" />
                                                        <ComboBoxItem Content="暖调复古黑白" Tag="bw_warm" />
                                                    </ComboBox>
                                                </Grid>
                                                <controls:StudioSliderRow Title="滤镜强度 %" Minimum="0" Maximum="100" Step="1" DefaultValue="100" Value="{Binding EditFilterIntensity}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted"
                                                                          Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- 子页 1：曲线与分色 -->
                                    <StackPanel IsEnabled="{Binding HasSelectedAsset}" Visibility="{Binding ColorSubTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=1}">
                                        <Border Style="{StaticResource PanelCard}">
                                            <StackPanel>
                                                <DockPanel Style="{StaticResource CardHeader}">
                                                    <Button Content="重置" Style="{StaticResource MiniButton}" DockPanel.Dock="Right" Command="{Binding ResetCurvesAndLevelsCommand}" IsEnabled="{Binding HasCurvesLevelsEdits}" ToolTip="重置「曲线与色阶」参数" />
                                                    <TextBlock Text="曲线与色阶" Style="{StaticResource CardTitle}" />
                                                </DockPanel>
                                                <UniformGrid Rows="1" Margin="0,0,0,6">
                                                    <ToggleButton Style="{StaticResource PillToggleButton}" Margin="0,0,2,0" ToolTip="RGB 综合通道" IsChecked="{Binding ActiveCurveChannel, Converter={StaticResource EnumEquals}, ConverterParameter=0, Mode=OneWay}" Click="CurveCh0_Click">
                                                        <Grid>
                                                            <TextBlock Text="RGB" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                            <Canvas Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                <Ellipse Width="4" Height="4" Canvas.Left="3" Canvas.Top="-2" Fill="{DynamicResource BrushAccent}" Visibility="{Binding HasMasterCurveEdit, Converter={StaticResource BoolToVis}}" />
                                                            </Canvas>
                                                        </Grid>
                                                    </ToggleButton>
                                                    <ToggleButton Style="{StaticResource PillToggleButton}" Margin="2,0,2,0" IsChecked="{Binding ActiveCurveChannel, Converter={StaticResource EnumEquals}, ConverterParameter=1, Mode=OneWay}" Click="CurveCh1_Click">
                                                        <Grid>
                                                            <TextBlock Text="红" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                            <Canvas Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                <Ellipse Width="4" Height="4" Canvas.Left="3" Canvas.Top="-2" Fill="#EF4444" Visibility="{Binding HasRedCurveEdit, Converter={StaticResource BoolToVis}}" />
                                                            </Canvas>
                                                        </Grid>
                                                    </ToggleButton>
                                                    <ToggleButton Style="{StaticResource PillToggleButton}" Margin="2,0,2,0" IsChecked="{Binding ActiveCurveChannel, Converter={StaticResource EnumEquals}, ConverterParameter=2, Mode=OneWay}" Click="CurveCh2_Click">
                                                        <Grid>
                                                            <TextBlock Text="绿" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                            <Canvas Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                <Ellipse Width="4" Height="4" Canvas.Left="3" Canvas.Top="-2" Fill="#22C55E" Visibility="{Binding HasGreenCurveEdit, Converter={StaticResource BoolToVis}}" />
                                                            </Canvas>
                                                        </Grid>
                                                    </ToggleButton>
                                                    <ToggleButton Style="{StaticResource PillToggleButton}" Margin="2,0,0,0" IsChecked="{Binding ActiveCurveChannel, Converter={StaticResource EnumEquals}, ConverterParameter=3, Mode=OneWay}" Click="CurveCh3_Click">
                                                        <Grid>
                                                            <TextBlock Text="蓝" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                            <Canvas Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                <Ellipse Width="4" Height="4" Canvas.Left="3" Canvas.Top="-2" Fill="#3B82F6" Visibility="{Binding HasBlueCurveEdit, Converter={StaticResource BoolToVis}}" />
                                                            </Canvas>
                                                        </Grid>
                                                    </ToggleButton>
                                                </UniformGrid>
                                                <controls:ToneCurveControl x:Name="ToneCurveEditor" Height="150"
                                                                           Curves="{Binding ActiveToneCurves}"
                                                                           ActiveChannel="{Binding ActiveCurveChannel}"
                                                                           CurveEditStarted="Slider_EditStarted"
                                                                           CurveEditCompleted="Slider_EditCompleted"
                                                                           CurveChanged="ToneCurveEditor_CurveChanged" />
                                                <TextBlock Text="左键添加或拖动，右键删点，双击重置通道" Style="{StaticResource Caption}" Foreground="{DynamicResource BrushTextMuted}" Margin="0,4,0,8" />
                                                <controls:StudioSliderRow Title="输入黑场" Minimum="0" Maximum="180" Step="1" DefaultValue="0" Value="{Binding EditInputBlack}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <controls:StudioSliderRow Title="输入白场" Minimum="75" Maximum="255" Step="1" DefaultValue="255" Value="{Binding EditInputWhite}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <controls:StudioSliderRow Title="输出黑场" Minimum="0" Maximum="120" Step="1" DefaultValue="0" Value="{Binding EditOutputBlack}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <controls:StudioSliderRow Title="输出白场" Minimum="135" Maximum="255" Step="1" DefaultValue="255" Value="{Binding EditOutputWhite}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource PanelCard}" BorderThickness="0">
                                            <StackPanel>
                                                <DockPanel Style="{StaticResource CardHeader}">
                                                    <Button Content="重置" Style="{StaticResource MiniButton}" DockPanel.Dock="Right" Command="{Binding ResetHslGroupCommand}" IsEnabled="{Binding HasHslEdits}" ToolTip="重置「HSL 分色」参数" />
                                                    <TextBlock Text="HSL 分色" Style="{StaticResource CardTitle}" />
                                                </DockPanel>
                                                <UniformGrid Rows="2" Columns="4" Margin="0,0,0,6">
                                                    <ToggleButton Style="{StaticResource PillToggleButton}" Margin="2" IsChecked="{Binding ActiveHslChannel, Converter={StaticResource EnumEquals}, ConverterParameter=0, Mode=OneWay}" Click="HslCh_Click" Tag="0">
                                                        <Grid>
                                                            <TextBlock Text="红" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                            <Canvas Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                <Ellipse Width="4" Height="4" Canvas.Left="3" Canvas.Top="-2" Fill="{DynamicResource BrushAccent}" Visibility="{Binding HasHslRedEdit, Converter={StaticResource BoolToVis}}" />
                                                            </Canvas>
                                                        </Grid>
                                                    </ToggleButton>
                                                    <ToggleButton Style="{StaticResource PillToggleButton}" Margin="2" IsChecked="{Binding ActiveHslChannel, Converter={StaticResource EnumEquals}, ConverterParameter=1, Mode=OneWay}" Click="HslCh_Click" Tag="1">
                                                        <Grid>
                                                            <TextBlock Text="橙(肤)" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                            <Canvas Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                <Ellipse Width="4" Height="4" Canvas.Left="3" Canvas.Top="-2" Fill="{DynamicResource BrushAccent}" Visibility="{Binding HasHslOrangeEdit, Converter={StaticResource BoolToVis}}" />
                                                            </Canvas>
                                                        </Grid>
                                                    </ToggleButton>
                                                    <ToggleButton Style="{StaticResource PillToggleButton}" Margin="2" IsChecked="{Binding ActiveHslChannel, Converter={StaticResource EnumEquals}, ConverterParameter=2, Mode=OneWay}" Click="HslCh_Click" Tag="2">
                                                        <Grid>
                                                            <TextBlock Text="黄" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                            <Canvas Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                <Ellipse Width="4" Height="4" Canvas.Left="3" Canvas.Top="-2" Fill="{DynamicResource BrushAccent}" Visibility="{Binding HasHslYellowEdit, Converter={StaticResource BoolToVis}}" />
                                                            </Canvas>
                                                        </Grid>
                                                    </ToggleButton>
                                                    <ToggleButton Style="{StaticResource PillToggleButton}" Margin="2" IsChecked="{Binding ActiveHslChannel, Converter={StaticResource EnumEquals}, ConverterParameter=3, Mode=OneWay}" Click="HslCh_Click" Tag="3">
                                                        <Grid>
                                                            <TextBlock Text="绿" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                            <Canvas Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                <Ellipse Width="4" Height="4" Canvas.Left="3" Canvas.Top="-2" Fill="{DynamicResource BrushAccent}" Visibility="{Binding HasHslGreenEdit, Converter={StaticResource BoolToVis}}" />
                                                            </Canvas>
                                                        </Grid>
                                                    </ToggleButton>
                                                    <ToggleButton Style="{StaticResource PillToggleButton}" Margin="2" IsChecked="{Binding ActiveHslChannel, Converter={StaticResource EnumEquals}, ConverterParameter=4, Mode=OneWay}" Click="HslCh_Click" Tag="4">
                                                        <Grid>
                                                            <TextBlock Text="青" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                            <Canvas Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                <Ellipse Width="4" Height="4" Canvas.Left="3" Canvas.Top="-2" Fill="{DynamicResource BrushAccent}" Visibility="{Binding HasHslCyanEdit, Converter={StaticResource BoolToVis}}" />
                                                            </Canvas>
                                                        </Grid>
                                                    </ToggleButton>
                                                    <ToggleButton Style="{StaticResource PillToggleButton}" Margin="2" IsChecked="{Binding ActiveHslChannel, Converter={StaticResource EnumEquals}, ConverterParameter=5, Mode=OneWay}" Click="HslCh_Click" Tag="5">
                                                        <Grid>
                                                            <TextBlock Text="蓝(底)" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                            <Canvas Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                <Ellipse Width="4" Height="4" Canvas.Left="3" Canvas.Top="-2" Fill="{DynamicResource BrushAccent}" Visibility="{Binding HasHslBlueEdit, Converter={StaticResource BoolToVis}}" />
                                                            </Canvas>
                                                        </Grid>
                                                    </ToggleButton>
                                                    <ToggleButton Style="{StaticResource PillToggleButton}" Margin="2" IsChecked="{Binding ActiveHslChannel, Converter={StaticResource EnumEquals}, ConverterParameter=6, Mode=OneWay}" Click="HslCh_Click" Tag="6">
                                                        <Grid>
                                                            <TextBlock Text="紫" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                            <Canvas Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                <Ellipse Width="4" Height="4" Canvas.Left="3" Canvas.Top="-2" Fill="{DynamicResource BrushAccent}" Visibility="{Binding HasHslPurpleEdit, Converter={StaticResource BoolToVis}}" />
                                                            </Canvas>
                                                        </Grid>
                                                    </ToggleButton>
                                                    <ToggleButton Style="{StaticResource PillToggleButton}" Margin="2" IsChecked="{Binding ActiveHslChannel, Converter={StaticResource EnumEquals}, ConverterParameter=7, Mode=OneWay}" Click="HslCh_Click" Tag="7">
                                                        <Grid>
                                                            <TextBlock Text="品红" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                                            <Canvas Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                <Ellipse Width="4" Height="4" Canvas.Left="3" Canvas.Top="-2" Fill="{DynamicResource BrushAccent}" Visibility="{Binding HasHslMagentaEdit, Converter={StaticResource BoolToVis}}" />
                                                            </Canvas>
                                                        </Grid>
                                                    </ToggleButton>
                                                </UniformGrid>
                                                <controls:StudioSliderRow Title="色相偏移" Minimum="-100" Maximum="100" Step="1" DefaultValue="0" Value="{Binding HslHue}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <controls:StudioSliderRow Title="饱和度" Minimum="-100" Maximum="100" Step="1" DefaultValue="0" Value="{Binding HslSaturation}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <controls:StudioSliderRow Title="明度提亮" Minimum="-100" Maximum="100" Step="1" DefaultValue="0" Value="{Binding HslLightness}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- 子页 2：裁剪与人像 -->
                                    <StackPanel Visibility="{Binding ColorSubTabIndex, Converter={StaticResource IntEqualsToVis}, ConverterParameter=2}">
                                        <Border Style="{StaticResource PanelCard}" IsEnabled="{Binding HasSelectedAsset}">
                                            <StackPanel>
                                                <DockPanel Style="{StaticResource CardHeader}">
                                                    <Button Content="重置" Style="{StaticResource MiniButton}" DockPanel.Dock="Right" Command="{Binding ResetCropGeometryCommand}" IsEnabled="{Binding HasCropGeometryEdits}" ToolTip="重置旋转、缩放与偏移" />
                                                    <TextBlock Text="裁剪与拉直" Style="{StaticResource CardTitle}" />
                                                </DockPanel>
                                                <UniformGrid Rows="1" Margin="0,0,0,6">
                                                    <Button Style="{StaticResource ModernButton}" Margin="0,0,3,0" Command="{Binding RotateQuarterLeftCommand}" ToolTip="逆时针旋转 90°（Ctrl+[）" AutomationProperties.Name="逆时针旋转 90 度">
                                                        <Path Data="{StaticResource IconRotateLeft}" Style="{StaticResource VecIcon}" />
                                                    </Button>
                                                    <Button Style="{StaticResource ModernButton}" Margin="3,0,3,0" Command="{Binding RotateQuarterRightCommand}" ToolTip="顺时针旋转 90°（Ctrl+]）" AutomationProperties.Name="顺时针旋转 90 度">
                                                        <Path Data="{StaticResource IconRotateRight}" Style="{StaticResource VecIcon}" />
                                                    </Button>
                                                    <Button Style="{StaticResource ModernButton}" Margin="3,0,3,0" Command="{Binding ToggleFlipHorizontalCommand}" ToolTip="水平镜像" AutomationProperties.Name="水平镜像">
                                                        <Path Data="{StaticResource IconFlipH}" Style="{StaticResource VecIcon}" />
                                                    </Button>
                                                    <Button Style="{StaticResource ModernButton}" Margin="3,0,0,0" Command="{Binding ToggleFlipVerticalCommand}" ToolTip="垂直翻转" AutomationProperties.Name="垂直翻转">
                                                        <Path Data="{StaticResource IconFlipV}" Style="{StaticResource VecIcon}" />
                                                    </Button>
                                                </UniformGrid>
                                                <Button Content="旋转照片以适配格位方向" Style="{StaticResource ModernButton}" Margin="0,0,0,8"
                                                        Command="{Binding AutoOrientPhotoToSlotCommand}"
                                                        ToolTip="横图放在竖格（或竖图放在横格）时，旋转 90° 并满幅适配" />
                                                <controls:StudioSliderRow Title="水平拉直 °" Minimum="-45" Maximum="45" Step="0.2" DefaultValue="0" ValueFormat="0.0" Value="{Binding EditRotationDegrees}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <controls:StudioSliderRow Title="画面缩放" Minimum="1.0" Maximum="4.0" Step="0.05" DefaultValue="1.0" ValueFormat="0.00" Value="{Binding EditZoom}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <controls:StudioSliderRow Title="水平偏移" Minimum="-1.0" Maximum="1.0" Step="0.02" DefaultValue="0" ValueFormat="0.00" Value="{Binding EditPanX}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <controls:StudioSliderRow Title="垂直偏移" Minimum="-1.0" Maximum="1.0" Step="0.02" DefaultValue="0" ValueFormat="0.00" Value="{Binding EditPanY}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <CheckBox Content="裁切填满格位" IsChecked="{Binding IsCoverFitMode}" Margin="0,6,0,2"
                                                          ToolTip="取消时完整显示照片，并在格位内留白" />
                                                <TextBlock Text="{Binding EstimatedIdHeadInfo}" Height="16" FontSize="11"
                                                           Visibility="{Binding ActiveScenario, Converter={StaticResource EnumToVis}, ConverterParameter=IdPhoto}"
                                                           Foreground="{DynamicResource BrushStatusOk}" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding EstimatedIdHeadInfo}" />
                                                <Separator Margin="0,8" />
                                                <TextBlock Text="{Binding DetectedFaceSummaryText}" Height="16" FontSize="11"
                                                           Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DetectedFaceSummaryText}" />
                                                <UniformGrid Rows="1">
                                                    <Button Content="{Binding AutoFrameActionText}" Style="{StaticResource PrimaryButton}" Margin="0,0,4,0"
                                                            ToolTipService.ShowOnDisabled="True"
                                                            IsEnabled="{Binding CanAutoFramePhoto}"
                                                            ToolTip="按格位比例保留主体与原构图（证件照需加载离线人脸模型）"
                                                            Command="{Binding AutoFrameWithFaceCommand}" />
                                                    <Button Content="AI 双眼水平" Style="{StaticResource ModernButton}" Margin="4,0,0,0"
                                                            ToolTipService.ShowOnDisabled="True"
                                                            IsEnabled="{Binding HasFaceDetectionModel}"
                                                            Visibility="{Binding ActiveScenario, Converter={StaticResource EnumToVis}, ConverterParameter=IdPhoto}"
                                                            ToolTip="保持当前缩放位置，按左右瞳孔自动摆正（需加载离线人脸模型）"
                                                            Command="{Binding AutoLevelEyesCommand}" />
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource PanelCard}" IsEnabled="{Binding HasSelectedAsset}">
                                            <StackPanel>
                                                <DockPanel Style="{StaticResource CardHeader}">
                                                    <Button Content="重置" Style="{StaticResource MiniButton}" DockPanel.Dock="Right" Command="{Binding ResetDetailAndBgGroupCommand}" IsEnabled="{Binding HasDetailBgEdits}" ToolTip="重置人像优化、细节与换底参数" />
                                                    <TextBlock Text="人像与细节" Style="{StaticResource CardTitle}" />
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,4">
                                                    <Button DockPanel.Dock="Right" Content="应用到全部" Style="{StaticResource MiniButton}"
                                                            Visibility="{Binding ActiveScenario, Converter={StaticResource EnumToVis}, ConverterParameter=IdPhoto}"
                                                            IsEnabled="{Binding HasSelectedAsset}"
                                                            ToolTip="为工程中全部已排版证件照应用当前影棚风格和强度（可撤销）"
                                                            Command="{Binding BatchEnhanceAllIdPhotosCommand}" />
                                                    <CheckBox Content="影棚自动优化" IsChecked="{Binding EditStudioPortraitEnhance}"
                                                              IsEnabled="{Binding HasSelectedAsset}" VerticalAlignment="Center"
                                                              ToolTip="自动调整面部曝光和左右脸光线，保留五官细节" />
                                                </DockPanel>
                                                <StackPanel Visibility="{Binding EditStudioPortraitEnhance, Converter={StaticResource BoolToVis}}">
                                                    <Grid Margin="0,2,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="96" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="优化风格" Style="{StaticResource FieldLabel}" />
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding StudioEnhanceModeOptions}"
                                                                  DisplayMemberPath="Value"
                                                                  SelectedValuePath="Key"
                                                                  SelectedValue="{Binding EditStudioEnhanceMode, Mode=TwoWay}" AutomationProperties.Name="优化风格" />
                                                    </Grid>
                                                    <controls:StudioSliderRow Title="影棚优化强度" Minimum="0" Maximum="100" Step="1" DefaultValue="70" Value="{Binding EditStudioEnhanceStrength}"
                                                                              EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                </StackPanel>
                                                <Separator Margin="0,8" />
                                                <controls:StudioSliderRow Title="清晰度" Minimum="-100" Maximum="100" Step="1" DefaultValue="0" Value="{Binding EditClarity}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <controls:StudioSliderRow Title="打印锐化" Minimum="0" Maximum="100" Step="1" DefaultValue="0" Value="{Binding EditSharpening}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <controls:StudioSliderRow Title="保边柔肤" Minimum="0" Maximum="100" Step="1" DefaultValue="0" Value="{Binding EditSkinSoftening}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource PanelCard}">
                                            <StackPanel>
                                                <TextBlock Text="背景与换底" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                                <controls:StudioSliderRow Title="白墙提纯" Minimum="0" Maximum="100" Step="1" DefaultValue="0" Value="{Binding EditWhiteWallCleanup}" IsEnabled="{Binding HasSelectedAsset}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                <Separator Margin="0,8" />
                                                <CheckBox Content="AI 抠图换底（离线）" IsChecked="{Binding EditAiBackgroundReplace}" Margin="0,0,0,6"
                                                          ToolTipService.ShowOnDisabled="True" ToolTip="{Binding AiMattingStatusText}">
                                                    <CheckBox.Style>
                                                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding HasSelectedAsset}" Value="True" />
                                                                        <Condition Binding="{Binding HasAiMattingModel}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="IsEnabled" Value="True" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </CheckBox.Style>
                                                </CheckBox>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="换底模型" Style="{StaticResource FieldLabel}" />
                                                    <ComboBox x:Name="MattingModelCombo" Grid.Column="1" AutomationProperties.Name="换底模型"
                                                              ItemsSource="{Binding AvailableAiModels}" SelectedItem="{Binding SelectedAiModelName, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanSelectAiModel}" ToolTip="切换后会重新计算换底预览，此选择适用于当前软件">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="{Binding}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding}" Value="pas-photo-matting-v1.onnx">
                                                                                    <Setter Property="Text" Value="Pas（证件照推荐）" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding}" Value="hivision_modnet.onnx">
                                                                                    <Setter Property="Text" Value="Hivision MODNet" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding}" Value="birefnet-lite-matting-768-fp16.onnx">
                                                                                    <Setter Property="Text" Value="BiRefNet 768（细发）" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding}" Value="modnet_photographic_portrait_matting.onnx">
                                                                                    <Setter Property="Text" Value="MODNet（原版）" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>
                                                <TextBlock Text="纯色底" Style="{StaticResource GroupLabel}" Margin="0,0,0,6" />
                                                <WrapPanel Margin="0,0,0,4" IsEnabled="{Binding HasSelectedAsset}">
                                                    <Button Style="{StaticResource SwatchButton}" Background="#FFFFFF" ToolTip="纯白 #FFFFFF" AutomationProperties.Name="纯白底" Command="{Binding ApplyIdBackgroundColorCommand}" CommandParameter="#FFFFFF" />
                                                    <Button Style="{StaticResource SwatchButton}" Background="#438EDB" ToolTip="标准蓝 #438EDB" AutomationProperties.Name="标准蓝底" Command="{Binding ApplyIdBackgroundColorCommand}" CommandParameter="#438EDB" />
                                                    <Button Style="{StaticResource SwatchButton}" Background="#2B6CB0" ToolTip="深蓝 #2B6CB0" AutomationProperties.Name="深蓝底" Command="{Binding ApplyIdBackgroundColorCommand}" CommandParameter="#2B6CB0" />
                                                    <Button Style="{StaticResource SwatchButton}" Background="#D9001B" ToolTip="标准红 #D9001B" AutomationProperties.Name="标准红底" Command="{Binding ApplyIdBackgroundColorCommand}" CommandParameter="#D9001B" />
                                                    <Button Style="{StaticResource SwatchButton}" Background="#CBD5E1" ToolTip="浅灰 #CBD5E1" AutomationProperties.Name="浅灰底" Command="{Binding ApplyIdBackgroundColorCommand}" CommandParameter="#CBD5E1" />
                                                    <Button Style="{StaticResource ModernButton}" Padding="8,0" MinHeight="24" Height="24" Click="PickIdBackgroundColor_Click" ToolTip="自定义背景颜色" AutomationProperties.Name="自定义背景颜色">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,5,0" Background="{Binding EditReplacementBgHex, Converter={StaticResource HexToBrush}}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" />
                                                            <TextBlock Text="选色" FontSize="11" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </WrapPanel>

                                                <Expander Header="渐变底与边缘精修" Style="{StaticResource InlineExpander}" IsExpanded="False" IsEnabled="{Binding HasSelectedAsset}">
                                                    <StackPanel>
                                                        <CheckBox Content="中心柔光渐变底" IsChecked="{Binding EditUseGradientBg}" IsEnabled="{Binding HasAiMattingModel}" Margin="0,0,0,6" />
                                                        <WrapPanel Margin="0,0,0,8">
                                                            <Button Style="{StaticResource SwatchButton}" ToolTip="质感渐变蓝" AutomationProperties.Name="质感渐变蓝" Command="{Binding ApplyIdGradientBackgroundCommand}" CommandParameter="#1E4E8C|#6BA8E5">
                                                                <Button.Background>
                                                                    <RadialGradientBrush Center="0.5,0.38" GradientOrigin="0.5,0.38" RadiusX="0.7" RadiusY="0.7">
                                                                        <GradientStop Color="#6BA8E5" Offset="0" />
                                                                        <GradientStop Color="#1E4E8C" Offset="1" />
                                                                    </RadialGradientBrush>
                                                                </Button.Background>
                                                            </Button>
                                                            <Button Style="{StaticResource SwatchButton}" ToolTip="高级灰渐变" AutomationProperties.Name="高级灰渐变" Command="{Binding ApplyIdGradientBackgroundCommand}" CommandParameter="#525D6B|#DCE3EC">
                                                                <Button.Background>
                                                                    <RadialGradientBrush Center="0.5,0.38" GradientOrigin="0.5,0.38" RadiusX="0.7" RadiusY="0.7">
                                                                        <GradientStop Color="#DCE3EC" Offset="0" />
                                                                        <GradientStop Color="#525D6B" Offset="1" />
                                                                    </RadialGradientBrush>
                                                                </Button.Background>
                                                            </Button>
                                                            <Button Style="{StaticResource SwatchButton}" ToolTip="暖棕渐变" AutomationProperties.Name="暖棕渐变" Command="{Binding ApplyIdGradientBackgroundCommand}" CommandParameter="#5C4438|#C6AA96">
                                                                <Button.Background>
                                                                    <RadialGradientBrush Center="0.5,0.38" GradientOrigin="0.5,0.38" RadiusX="0.7" RadiusY="0.7">
                                                                        <GradientStop Color="#C6AA96" Offset="0" />
                                                                        <GradientStop Color="#5C4438" Offset="1" />
                                                                    </RadialGradientBrush>
                                                                </Button.Background>
                                                            </Button>
                                                            <Button Style="{StaticResource SwatchButton}" ToolTip="绯红渐变" AutomationProperties.Name="绯红渐变" Command="{Binding ApplyIdGradientBackgroundCommand}" CommandParameter="#991B1B|#F87171">
                                                                <Button.Background>
                                                                    <RadialGradientBrush Center="0.5,0.38" GradientOrigin="0.5,0.38" RadiusX="0.7" RadiusY="0.7">
                                                                        <GradientStop Color="#F87171" Offset="0" />
                                                                        <GradientStop Color="#991B1B" Offset="1" />
                                                                    </RadialGradientBrush>
                                                                </Button.Background>
                                                            </Button>
                                                            <Button Style="{StaticResource ModernButton}" Padding="8,0" MinHeight="24" Height="24" Click="PickIdSecondaryBgColor_Click"
                                                                    ToolTip="自定义渐变中心亮色" AutomationProperties.Name="自定义渐变高光色"
                                                                    Visibility="{Binding EditUseGradientBg, Converter={StaticResource BoolToVis}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,5,0" Background="{Binding EditReplacementBgSecondaryHex, Converter={StaticResource HexToBrush}}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" />
                                                                    <TextBlock Text="高光色" FontSize="11" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </WrapPanel>
                                                        <controls:StudioSliderRow Title="边缘内缩羽化" Minimum="0" Maximum="6" Step="0.5" DefaultValue="0.5" ValueFormat="0.0" Value="{Binding EditMattingFeather}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                        <controls:StudioSliderRow Title="去白边/溢色" Minimum="0" Maximum="100" Step="1" DefaultValue="60" Value="{Binding EditSpillSuppression}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                        <controls:StudioSliderRow Title="边缘收扩" Minimum="-2.0" Maximum="1.0" Step="0.1" DefaultValue="0.0" ValueFormat="0.0" Value="{Binding EditMattingEdgeShift}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </Border>

                                        <Expander Style="{StaticResource StudioExpander}" Margin="0"
                                                  IsExpanded="{Binding IsSuitOverlayActive, Mode=OneWay}">
                                            <Expander.Header>
                                                <TextBlock Text="电子正装（可选）" />
                                            </Expander.Header>
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="6,0,0,0">
                                                        <Button Content="贴图目录" Style="{StaticResource MiniButton}"
                                                                ToolTip="打开 portable_data\suits，可放入自定义透明 PNG 正装"
                                                                Command="{Binding OpenSuitsDirectoryCommand}" />
                                                        <Button Content="刷新" Style="{StaticResource MiniButton}"
                                                                ToolTip="重新扫描自定义正装 PNG"
                                                                Command="{Binding RefreshFormalSuitsCommand}" />
                                                    </StackPanel>
                                                    <ComboBox ItemsSource="{Binding FormalSuitOptions}" SelectedItem="{Binding SelectedFormalSuitOption, Mode=TwoWay}"
                                                              IsEnabled="{Binding HasSelectedAsset}"
                                                              DisplayMemberPath="Name" AutomationProperties.Name="电子正装款式" />
                                                </DockPanel>
                                                <StackPanel Visibility="{Binding IsSuitOverlayActive, Converter={StaticResource BoolToVis}}">
                                                    <Button Content="AI 自动贴合肩颈" Style="{StaticResource ModernButton}" Margin="0,0,0,6"
                                                            IsEnabled="{Binding HasFaceDetectionModel}" Command="{Binding AutoAlignFormalSuitCommand}" />
                                                    <controls:StudioSliderRow Title="衣领缩放" Minimum="0.45" Maximum="1.80" Step="0.02" DefaultValue="1.00" ValueFormat="0.00" Value="{Binding EditSuitScale}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                    <controls:StudioSliderRow Title="上下位置" Minimum="0.20" Maximum="0.90" Step="0.005" DefaultValue="0.60" ValueFormat="0.000" Value="{Binding EditSuitNeckYRatio}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                    <controls:StudioSliderRow Title="左右位置" Minimum="0.15" Maximum="0.85" Step="0.005" DefaultValue="0.50" ValueFormat="0.000" Value="{Binding EditSuitCenterXRatio}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- ==================== TAB 2：卡片装饰 ==================== -->
                    <TabItem Header="卡片装饰" Style="{StaticResource StudioTabItem}" ToolTip="Alt+2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,12,14">
                            <StackPanel>
                                <!-- 拍立得外观 -->
                                <Border Style="{StaticResource PanelCard}"
                                        Visibility="{Binding IsPolaroidControlsVisible, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="拍立得外观" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />

                                        <TextBlock Text="边框颜色" Style="{StaticResource GroupLabel}" Margin="0,0,0,6" />
                                        <WrapPanel Margin="0,0,0,6">
                                            <Button Style="{StaticResource SwatchButton}" Background="#FFFFFF" ToolTip="经典纯白" AutomationProperties.Name="经典纯白" Command="{Binding ApplyPolaroidFrameColorCommand}" CommandParameter="#FFFFFF" />
                                            <Button Style="{StaticResource SwatchButton}" Background="#FAF6EE" ToolTip="复古米白" AutomationProperties.Name="复古米白" Command="{Binding ApplyPolaroidFrameColorCommand}" CommandParameter="#FAF6EE" />
                                            <Button Style="{StaticResource SwatchButton}" Background="#1E2024" ToolTip="暗夜黑" AutomationProperties.Name="暗夜黑" Command="{Binding ApplyPolaroidFrameColorCommand}" CommandParameter="#1E2024" />
                                            <Button Style="{StaticResource SwatchButton}" Background="#F6E6E8" ToolTip="樱花粉" AutomationProperties.Name="樱花粉" Command="{Binding ApplyPolaroidFrameColorCommand}" CommandParameter="#F6E6E8" />
                                            <Button Style="{StaticResource SwatchButton}" Background="#E4EEF5" ToolTip="雾霾蓝" AutomationProperties.Name="雾霾蓝" Command="{Binding ApplyPolaroidFrameColorCommand}" CommandParameter="#E4EEF5" />
                                            <Button Style="{StaticResource SwatchButton}" Background="#E6EFE8" ToolTip="鼠尾草绿" AutomationProperties.Name="鼠尾草绿" Command="{Binding ApplyPolaroidFrameColorCommand}" CommandParameter="#E6EFE8" />
                                            <Button Style="{StaticResource SwatchButton}" Background="#F3EBDD" ToolTip="燕麦奶茶" AutomationProperties.Name="燕麦奶茶" Command="{Binding ApplyPolaroidFrameColorCommand}" CommandParameter="#F3EBDD" />
                                            <Button Style="{StaticResource ModernButton}" Padding="8,0" MinHeight="24" Height="24" Click="PickPolaroidFrameColor_Click"
                                                    ToolTip="自定义边框颜色" AutomationProperties.Name="自定义边框颜色">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,5,0" Background="{Binding PolaroidFrameColorHex, Converter={StaticResource HexToBrush}}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" />
                                                    <TextBlock Text="选色" FontSize="11" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>

                                        <WrapPanel Margin="0,0,0,8">
                                            <CheckBox Content="内框压痕阴影" IsChecked="{Binding PolaroidInnerShadow}" Margin="0,0,16,0" />
                                            <CheckBox Content="相纸颗粒" IsChecked="{Binding PolaroidPaperGrain}" />
                                        </WrapPanel>

                                        <Separator Margin="0,2,0,8" />
                                        <TextBlock Text="底部签名" Style="{StaticResource GroupLabel}" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding PolaroidCaptionTemplate, UpdateSourceTrigger=PropertyChanged, Delay=250}" AcceptsReturn="True" Height="48" TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top" Padding="8,6" Margin="0,0,0,6" AutomationProperties.Name="底部签名文案"
                                                 GotKeyboardFocus="Slider_EditStarted" LostKeyboardFocus="CaptionTextBox_LostKeyboardFocus"
                                                 ToolTip="支持变量：{Date} 日期、{Camera} 相机、{Filename} 文件名、{Index} 序号" />
                                        <WrapPanel Margin="0,0,0,8">
                                            <Button Content="+ 日期" Style="{StaticResource ChipButton}" Command="{Binding InsertPolaroidTokenCommand}" CommandParameter="{}{Date}" ToolTip="插入 {Date}" />
                                            <Button Content="+ 相机" Style="{StaticResource ChipButton}" Command="{Binding InsertPolaroidTokenCommand}" CommandParameter="{}{Camera}" ToolTip="插入 {Camera}" />
                                            <Button Content="+ 文件名" Style="{StaticResource ChipButton}" Command="{Binding InsertPolaroidTokenCommand}" CommandParameter="{}{Filename}" ToolTip="插入 {Filename}" />
                                            <Button Content="+ 序号" Style="{StaticResource ChipButton}" Command="{Binding InsertPolaroidTokenCommand}" CommandParameter="{}{Index}" ToolTip="插入 {Index}" />
                                        </WrapPanel>

                                        <ComboBox ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding PolaroidFontFamily, Mode=TwoWay}" Margin="0,0,0,6"
                                                  ToolTip="签名字体" AutomationProperties.Name="签名字体" />
                                        <controls:StudioSliderRow LabelWidth="64" Title="字号 pt" Minimum="6" Maximum="20" Step="0.5" DefaultValue="9" ValueFormat="0.0" Value="{Binding PolaroidFontSizePt}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted" />
                                        <Grid Margin="0,6,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding PolaroidTextAlignments}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                                      SelectedValue="{Binding PolaroidTextAlign, Mode=TwoWay}" ToolTip="对齐方式" AutomationProperties.Name="签名对齐方式" />
                                            <ComboBox Grid.Column="2" SelectedValue="{Binding PolaroidTextColorHex, Mode=TwoWay}" SelectedValuePath="Tag"
                                                      ToolTip="文字颜色" AutomationProperties.Name="签名文字颜色">
                                                <ComboBoxItem Content="深灰字" Tag="#374151" />
                                                <ComboBoxItem Content="纯黑字" Tag="#111827" />
                                                <ComboBoxItem Content="复古棕" Tag="#6B4F3B" />
                                                <ComboBoxItem Content="纯白反色" Tag="#F9FAFB" />
                                            </ComboBox>
                                            <Button Grid.Column="4" Style="{StaticResource ModernButton}" Width="28" Padding="0" Click="PickPolaroidTextColor_Click"
                                                    ToolTip="自定义文字颜色" AutomationProperties.Name="自定义文字颜色">
                                                <Border Width="12" Height="12" CornerRadius="2" Background="{Binding PolaroidTextColorHex, Converter={StaticResource HexToBrush}}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" />
                                            </Button>
                                        </Grid>

                                        <UniformGrid Rows="1" Margin="-3,0">
                                            <Button Content="同步到本页卡片" Style="{StaticResource ModernButton}" Margin="3,0" Command="{Binding ApplyPolaroidStyleToAllSlotsCommand}"
                                                    Visibility="{Binding HasMultiplePolaroidSlotsOnActiveSheet, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="把当前卡片的拍立得样式应用到本页全部卡片（可撤销）" />
                                            <Button Content="同步到全部页" Style="{StaticResource ModernButton}" Margin="3,0" Command="{Binding ApplyPolaroidStyleToAllPagesCommand}"
                                                    Visibility="{Binding HasPolaroidSlotsAcrossMultiplePages, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="把当前卡片的拍立得样式应用到工程中全部拍立得卡片（可撤销）" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- 非拍立得场景 -->
                                <Border Style="{StaticResource PanelCard}"
                                        Visibility="{Binding IsPolaroidControlsVisible, Converter={StaticResource InverseBoolToVis}}">
                                    <DockPanel>
                                        <Button Content="切换到拍立得" Style="{StaticResource ModernButton}" Click="ScenarioPolaroid_Click" DockPanel.Dock="Right" Margin="8,0,0,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="拍立得外观" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="边框颜色与签名仅用于拍立得排版" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- 通用页面外观 -->
                                <Border Style="{StaticResource PanelCard}" BorderThickness="0">
                                    <StackPanel>
                                        <TextBlock Text="页面外观" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                        <controls:StudioSliderRow LabelWidth="76" Title="卡片圆角 mm" Minimum="0" Maximum="6" Step="0.2" DefaultValue="{Binding SelectedTemplate.CustomCornerRadiusMm, FallbackValue=0}" ValueFormat="0.0" Value="{Binding LayoutCornerRadiusMm}" EditStarted="Slider_EditStarted" EditCompleted="Slider_EditCompleted"
                                                                  Visibility="{Binding CanEditAutoLayoutSliders, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="纸张底色" Style="{StaticResource GroupLabel}" Margin="0,8,0,6" />
                                        <WrapPanel Margin="0,0,0,8">
                                            <Button Style="{StaticResource SwatchButton}" Background="#FFFFFF" ToolTip="纯白" AutomationProperties.Name="纯白底色" Click="ApplyCanvasBg_Click" Tag="#FFFFFF" />
                                            <Button Style="{StaticResource SwatchButton}" Background="#FAF6EE" ToolTip="暖米白" AutomationProperties.Name="暖米白底色" Click="ApplyCanvasBg_Click" Tag="#FAF6EE" />
                                            <Button Style="{StaticResource SwatchButton}" Background="#F1F5F9" ToolTip="浅灰" AutomationProperties.Name="浅灰底色" Click="ApplyCanvasBg_Click" Tag="#F1F5F9" />
                                            <Button Style="{StaticResource SwatchButton}" Background="#181A20" ToolTip="深色" AutomationProperties.Name="深色底色" Click="ApplyCanvasBg_Click" Tag="#181A20" />
                                            <Button Style="{StaticResource ModernButton}" Padding="8,0" MinHeight="24" Height="24" Click="PickCanvasBgColor_Click"
                                                    ToolTip="自定义纸张底色" AutomationProperties.Name="自定义纸张底色">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,5,0" Background="{Binding CanvasBackgroundHex, Converter={StaticResource HexToBrush}}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" />
                                                    <TextBlock Text="选色" FontSize="11" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                        <CheckBox Content="页脚印前信息与 11 级灰阶条" IsChecked="{Binding ShowSlugFooter}" Margin="0,0,0,10"
                                                  ToolTip="在页脚输出印前信息与灰阶测试条（Slug），会写入导出文件和打印成品" />
                                        <StackPanel Margin="0,0,0,10" Visibility="{Binding CanEditNonPolaroidCaption, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="当前格位标注（留空则不显示）" Style="{StaticResource GroupLabel}" Margin="0,0,0,4" />
                                            <TextBox Text="{Binding SelectedSlotCaption, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                                     GotKeyboardFocus="Slider_EditStarted" LostKeyboardFocus="CaptionTextBox_LostKeyboardFocus"
                                                     AutomationProperties.Name="当前格位标注"
                                                     ToolTip="在格位底部添加标注，留空即可清除" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ==================== TAB 3：打印导出 ==================== -->
                    <TabItem Header="打印导出" Style="{StaticResource StudioTabItem}" ToolTip="Alt+3">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,12,14">
                            <StackPanel>
                                <!-- 印前预检 -->
                                <Border Style="{StaticResource PanelCard}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock x:Name="PreflightTabStatus" Text="全部通过" DockPanel.Dock="Right" Foreground="{DynamicResource BrushStatusOk}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="印前预检" Style="{StaticResource CardTitle}" />
                                        </DockPanel>
                                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"
                                                      Visibility="{Binding HasPreflightIssues, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl ItemsSource="{Binding PreflightReport.Issues}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Style="{StaticResource GhostButton}" Padding="8,5"
                                                                    HorizontalContentAlignment="Left" Click="PreflightIssue_Click" ToolTip="定位到对应格位">
                                                                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource BrushTextPrimary}">
                                                                    <Run Text="{Binding Category, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Message, Mode=OneWay}" Foreground="{DynamicResource BrushTextSecondary}" />
                                                                </TextBlock>
                                                            </Button>
                                                            <Button Grid.Column="1" Style="{StaticResource ModernButton}" Padding="8,0" MinHeight="24" Margin="4,0,0,0"
                                                                    FontSize="11" VerticalAlignment="Center"
                                                                    Content="{Binding QuickFixLabel}"
                                                                    Visibility="{Binding HasQuickFix, Converter={StaticResource BoolToVis}}"
                                                                    Command="{Binding DataContext.ApplyPreflightQuickFixCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>

                                <!-- 打印 -->
                                <Border Style="{StaticResource PanelCard}">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource CardHeader}">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                <Button Content="刷新" Style="{StaticResource MiniButton}" Click="RefreshPrinters_Click" ToolTip="重新扫描打印机" />
                                                <Button Content="设置" Style="{StaticResource MiniButton}" Click="OutputSettings_Click" ToolTip="默认打印机、分辨率与色彩配置" />
                                            </StackPanel>
                                            <TextBlock Text="打印" Style="{StaticResource CardTitle}" />
                                        </DockPanel>

                                        <ComboBox ItemsSource="{Binding Source={StaticResource PrinterGroups}}" DisplayMemberPath="Name"
                                                  SelectedValuePath="Name" SelectedValue="{Binding SelectedPrinterName, Mode=TwoWay}" Margin="0,0,0,6"
                                                  ToolTip="打印机" AutomationProperties.Name="打印机">
                                            <ComboBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource GroupLabel}" Margin="9,6,9,2" />
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ComboBox.GroupStyle>
                                        </ComboBox>
                                        <TextBlock Text="{Binding PrinterHardwareSummary}" Style="{StaticResource Caption}" Margin="0,0,0,6"
                                                   Visibility="{Binding InstalledPrinters.Count, Converter={StaticResource IntZeroToVis}}" />

                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="份数" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource IconButtonSmall}" Command="{Binding DecreasePrintCopiesCommand}"
                                                        ToolTip="减少份数" AutomationProperties.Name="减少打印份数">
                                                    <Path Data="{StaticResource IconMinus}" Style="{StaticResource VecIcon}" Width="10" Height="10" />
                                                </Button>
                                                <TextBox Text="{Binding PrintCopies, UpdateSourceTrigger=Explicit}" Width="56" Margin="2,0"
                                                         Style="{StaticResource NumericInput}" TextAlignment="Center"
                                                         PreviewKeyDown="PrintCopies_Commit" LostKeyboardFocus="PrintCopies_Commit"
                                                         AutomationProperties.Name="打印份数" />
                                                <Button Style="{StaticResource IconButtonSmall}" Command="{Binding IncreasePrintCopiesCommand}"
                                                        ToolTip="增加份数" AutomationProperties.Name="增加打印份数">
                                                    <Path Data="{StaticResource IconPlus}" Style="{StaticResource VecIcon}" Width="10" Height="10" />
                                                </Button>
                                            </StackPanel>
                                            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource MiniButton}"
                                                    Click="OutputSettings_Click" ToolTip="更改打印分辨率">
                                                <TextBlock Text="{Binding PrintDpi, StringFormat={}{0} DPI}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Button>
                                        </DockPanel>

                                        <Button Style="{StaticResource PrimaryButton}" MinHeight="32" Margin="0,0,0,6" Command="{Binding PrintActiveSheetCommand}"
                                                ToolTip="Ctrl+P">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconPrint}" Style="{StaticResource VecIcon}" Width="13" Height="13" Margin="0,0,6,0" />
                                                <TextBlock Text="打印当前页" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource ModernButton}" Command="{Binding PrintAllSheetsCommand}"
                                                Visibility="{Binding HasMultiplePages, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Sheets.Count, StringFormat='连续打印全部 {0} 页'}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- 导出 -->
                                <Border Style="{StaticResource PanelCard}">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource CardHeader}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource MiniButton}" Click="OutputSettings_Click" ToolTip="更改导出分辨率和 JPG 品质">
                                                <TextBlock Text="{Binding ExportDpi, StringFormat={}{0} DPI}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Button>
                                            <TextBlock Text="导出" Style="{StaticResource CardTitle}" />
                                        </DockPanel>

                                        <!-- 单页时展示紧凑单行；多页时区分当前页与全部页 -->
                                        <UniformGrid Rows="1" Margin="0,0,0,6"
                                                     Visibility="{Binding HasMultiplePages, Converter={StaticResource InverseBoolToVis}}">
                                            <Button Content="JPG" Style="{StaticResource ModernButton}" Margin="0,0,3,0" Command="{Binding ExportCurrentJpegCommand}"
                                                    ToolTip="导出当前页为 JPG（Ctrl+E）" AutomationProperties.Name="导出当前页 JPG" />
                                            <Button Content="PNG" Style="{StaticResource ModernButton}" Margin="3,0,3,0" Command="{Binding ExportCurrentPngCommand}"
                                                    ToolTip="导出当前页为无损 PNG" AutomationProperties.Name="导出当前页 PNG" />
                                            <Button Content="PDF" Style="{StaticResource ModernButton}" Margin="3,0,0,0" Command="{Binding ExportAllToPdfCommand}"
                                                    ToolTip="导出为按物理尺寸排版的 PDF" AutomationProperties.Name="导出 PDF" />
                                        </UniformGrid>

                                        <Grid Margin="0,0,0,6" Visibility="{Binding HasMultiplePages, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="6" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="当前页" Style="{StaticResource FieldLabel}" />
                                            <Button Grid.Row="0" Grid.Column="1" Content="JPG" Style="{StaticResource ModernButton}" Command="{Binding ExportCurrentJpegCommand}"
                                                    ToolTip="导出当前页为 JPG（Ctrl+E）" AutomationProperties.Name="导出当前页 JPG" />
                                            <Button Grid.Row="0" Grid.Column="3" Content="PNG" Style="{StaticResource ModernButton}" Command="{Binding ExportCurrentPngCommand}"
                                                    ToolTip="导出当前页为无损 PNG" AutomationProperties.Name="导出当前页 PNG" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Sheets.Count, StringFormat='共 {0} 页'}" Style="{StaticResource FieldLabel}" />
                                            <Button Grid.Row="2" Grid.Column="1" Content="JPG" Style="{StaticResource ModernButton}" Command="{Binding ExportBatchJpegCommand}"
                                                    ToolTip="按 P01、P02… 批量导出全部页为 JPG" AutomationProperties.Name="批量导出全部 JPG" />
                                            <Button Grid.Row="2" Grid.Column="3" Content="PNG" Style="{StaticResource ModernButton}" Command="{Binding ExportBatchPngCommand}"
                                                    ToolTip="按 P01、P02… 批量导出全部页为 PNG" AutomationProperties.Name="批量导出全部 PNG" />
                                            <Button Grid.Row="2" Grid.Column="5" Content="PDF" Style="{StaticResource ModernButton}" Command="{Binding ExportAllToPdfCommand}"
                                                    ToolTip="导出全部页为按物理尺寸排版的多页 PDF" AutomationProperties.Name="导出全部页 PDF" />
                                        </Grid>

                                        <StackPanel Visibility="{Binding ActiveScenario, Converter={StaticResource EnumToVis}, ConverterParameter=IdPhoto}">
                                            <Separator Margin="0,6,0,8" />
                                            <TextBlock Text="单张电子证件照" Style="{StaticResource GroupLabel}" Margin="0,0,0,6" />
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{Binding DigitalIdMaxSizeKbOptions}"
                                                          DisplayMemberPath="Value"
                                                          SelectedValuePath="Key"
                                                          SelectedValue="{Binding DigitalIdMaxSizeKb, Mode=TwoWay}"
                                                          ToolTip="文件大小上限，据此调整 JPEG 品质" AutomationProperties.Name="电子照文件大小上限" />
                                                <Button Grid.Column="2" Content="导出电子照" Style="{StaticResource ModernButton}"
                                                        IsEnabled="{Binding HasSelectedAsset}" ToolTip="导出当前照片为单张电子证件照 JPG"
                                                        Command="{Binding ExportDigitalIdPhotoCommand}" />
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Margin="0,8,0,0" Visibility="{Binding IsExportBusy, Converter={StaticResource BoolToVis}}">
                                            <DockPanel Margin="0,0,0,4">
                                                <Button DockPanel.Dock="Right" Content="取消" Style="{StaticResource MiniButton}" Command="{Binding CancelExportCommand}" />
                                                <TextBlock Text="{Binding ExportProgressText}" Style="{StaticResource FieldLabel}" FontSize="11" />
                                            </DockPanel>
                                            <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding ExportProgressPercent}"
                                                         IsIndeterminate="{Binding IsExportIndeterminate}" Foreground="{DynamicResource BrushAccent}"
                                                         Background="{DynamicResource BrushBorderStrong}" BorderThickness="0" />
                                        </StackPanel>
                                        <Button Content="打开上次导出文件夹" Style="{StaticResource MiniButton}" Command="{Binding OpenLastExportFolderCommand}"
                                                HorizontalAlignment="Left" Margin="-6,6,0,0" Visibility="{Binding HasLastExportDirectory, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>

                                <!-- 设备校准（低频，折叠） -->
                                <Expander Header="设备校准" Style="{StaticResource StudioExpander}" IsExpanded="False" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PrinterHardwareSummary}" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                                        <CheckBox Content="优先使用无边距纸型" IsChecked="{Binding PrinterBorderless}" Margin="0,0,0,8"
                                                  ToolTip="优先选择匹配的无边距纸型并隐藏安全边距提示。若驱动单独提供无边距，请在驱动首选项中开启。精确尺寸请在驱动中选择「保持大小」（若可用）。" />
                                        <UniformGrid Rows="1" Margin="0,0,0,6">
                                            <Button Style="{StaticResource ModernButton}" Margin="0,0,3,0" Click="OpenCalibrationDialog_Click" AutomationProperties.Name="校准向导">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconCalibration}" Style="{StaticResource VecIcon}" Width="12" Height="12" Margin="0,0,6,0" />
                                                    <TextBlock Text="校准向导" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Content="打印测试卡" Style="{StaticResource ModernButton}" Margin="3,0,0,0" Command="{Binding PrintCalibrationCardCommand}"
                                                    ToolTip="打印三合一测试卡：尺寸标尺、吃边刻度、灰阶与色靶" />
                                        </UniformGrid>
                                        <Button Content="打印机驱动首选项" Style="{StaticResource ModernButton}" Margin="0,0,0,6" Click="OpenPrinterPreferences_Click"
                                                ToolTip="打开驱动设置：纸型、质量、无边距" />
                                        <Button Content="双面翻页打印背面" Style="{StaticResource ModernButton}" Command="{Binding PrintDuplexBackSheetCommand}"
                                                ToolTip="按校准偏移打印背面，用于卡证正反面对齐" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </Border>
        </Grid>

        <!-- ==================== 3. 状态栏 ==================== -->
        <Border Grid.Row="2" Background="{DynamicResource BrushBgHeader}"
                BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="12,0">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource MiniButton}" VerticalAlignment="Center" Margin="8,0,-6,0"
                        Click="ShortcutsHelp_Click" ToolTip="查看全部键盘快捷键（F1）" AutomationProperties.Name="键盘快捷键">
                    <TextBlock Text="F1 快捷键" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" />
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                            Visibility="{Binding IsExportBusy, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Width="96" Height="5" Minimum="0" Maximum="100" Value="{Binding ExportProgressPercent}"
                                 IsIndeterminate="{Binding IsExportIndeterminate}" VerticalAlignment="Center"
                                 Foreground="{DynamicResource BrushAccent}" Background="{DynamicResource BrushBorderStrong}" BorderThickness="0" />
                    <Button Content="取消" Style="{StaticResource MiniButton}" Margin="6,0,0,0" MinHeight="18" Padding="6,0"
                            Command="{Binding CancelExportCommand}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="{Binding StatusText}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11"
                           ToolTip="{Binding StatusText}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
