<Window x:Class="PhotoPrintStudio.App.Views.HotFolderWatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PhotoPrintStudio.App.Controls"
        Title="联机拍摄热文件夹监视（相机协同工作流）"
        Width="580" Height="640" MinWidth="500" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BrushBgPanel}">
    <DockPanel Margin="16">
        <!-- 底部安全提示 + 完成按钮 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="完成" IsCancel="True" Style="{StaticResource PrimaryButton}" MinWidth="84" />
            <TextBlock Text="安全防误打：联机导入永不自动触发打印；拍完微调后点主界面「打印」仅输出当前页。"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                       FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. 监视状态总控卡 -->
                <Border Style="{StaticResource PanelCard}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource BrushTextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHotFolderWatching}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource BrushStatusOk}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrushTextPrimary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="联机热文件夹监视（未启用）" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHotFolderWatching}" Value="True">
                                                    <Setter Property="Text" Value="正在实时监视相机输出文件夹" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding HotFolderStatusSummary}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushTextSecondary}" />
                            <TextBlock Text="{Binding HotFolderLastEventText}" FontSize="10.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrushTextMuted}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHotFolderWatching}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Content="导入已有照片并监视" Style="{StaticResource PrimaryButton}" Height="32" Margin="0,0,0,6"
                                    Command="{Binding ImportExistingAndWatchHotFolderCommand}" />
                            <Button Content="仅监视新增照片" Style="{StaticResource ModernButton}" Height="32"
                                    Command="{Binding WatchNewHotFolderPhotosCommand}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="暂停监视" Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Center" MinWidth="96" Height="32"
                                Visibility="{Binding IsHotFolderWatching, Converter={StaticResource BoolToVis}}"
                                Command="{Binding StopHotFolderWatchCommand}" />
                    </Grid>
                </Border>

                <!-- 2. 监视目录选择 -->
                <Border Style="{StaticResource PanelCard}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="1. 相机联机输出文件夹" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                        <TextBlock Text="将相机联机软件（如 EOS Utility / Imaging Edge / 无线传图）的保存目录设为此处即可实现拍完自动入库。"
                                   FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding HotFolderWatchDirectory, UpdateSourceTrigger=LostFocus}"
                                     Height="28" VerticalContentAlignment="Center"
                                     ToolTip="输入或选择相机输出照片所在的本地文件夹路径" />
                            <Button Grid.Column="2" Content="选择文件夹…" Style="{StaticResource ModernButton}" Height="28" Padding="10,0"
                                    Command="{Binding BrowseHotFolderDirectoryCommand}" />
                            <Button Grid.Column="4" Content="打开目录" Style="{StaticResource GhostButton}" Height="28" Padding="8,0"
                                    IsEnabled="{Binding HasHotFolderDirectory}"
                                    Command="{Binding OpenHotFolderDirectoryCommand}" />
                        </Grid>
                        <WrapPanel>
                            <CheckBox Content="同时监视子文件夹"
                                      IsChecked="{Binding HotFolderIncludeSubdirectories}" Margin="0,0,16,4" />
                        </WrapPanel>
                        <Button Content="立即补扫并导入该目录中尚未导入的照片" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left" Padding="8,3" Margin="0,4,0,0"
                                IsEnabled="{Binding IsHotFolderWatching}"
                                Command="{Binding ScanHotFolderExistingNowCommand}" />
                    </StackPanel>
                </Border>

                <!-- 3. 入库与排版策略（防样张误打核心） -->
                <Border Style="{StaticResource PanelCard}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="2. 新增照片入库与上版策略（防样张误打）" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding HotFolderPlacementOptions}"
                                  DisplayMemberPath="Value"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding HotFolderPlacementStrategy, Mode=TwoWay}"
                                  Margin="0,0,0,6" />
                        <TextBlock Text="说明：连拍试拍多张样张时，推荐使用「替换当前页成片」——所有历史样张均完整保留在底部素材库随时可切回，但打印页始终只保留当前满意成片，绝不会把全部试拍废片一起打印。"
                                   FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <CheckBox Content="新照片到达后自动切换画布选中并预览最新照片"
                                  IsChecked="{Binding HotFolderAutoSelectLatest}" />
                    </StackPanel>
                </Border>

                <!-- 4. 拍完即处理预设策略 -->
                <Border Style="{StaticResource PanelCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="3. 拍完即自动处理策略" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                        <TextBlock Text="调色与样式模板来源" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding HotFolderEditTemplateOptions}"
                                  DisplayMemberPath="Value"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding HotFolderEditTemplateMode, Mode=TwoWay}"
                                  Margin="0,0,0,6" />

                        <Grid Margin="0,0,0,8" Visibility="{Binding IsHotFolderPresetPickerVisible, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="指定预设" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Presets}"
                                      SelectedItem="{Binding HotFolderSelectedColorPreset, Mode=TwoWay}"
                                      DisplayMemberPath="Name" />
                        </Grid>

                        <Separator Margin="0,4,0,8" Background="{DynamicResource BrushBorderSubtle}" />
                        <TextBlock Text="附加一键自动化处理（可自由组合）" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6" />

                        <CheckBox Content="自动开启「一键影棚自动优化」"
                                  IsChecked="{Binding HotFolderAutoStudioEnhance}" Margin="0,0,0,4" />
                        <StackPanel Margin="20,0,0,8" Visibility="{Binding HotFolderAutoStudioEnhance, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="影棚风格" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding StudioEnhanceModeOptions}"
                                          DisplayMemberPath="Value"
                                          SelectedValuePath="Key"
                                          SelectedValue="{Binding HotFolderStudioEnhanceMode, Mode=TwoWay}" />
                            </Grid>
                            <controls:StudioSliderRow Title="优化强度" Minimum="0" Maximum="100" Step="5" DefaultValue="70"
                                                      Value="{Binding HotFolderStudioEnhanceStrength}" />
                        </StackPanel>

                        <CheckBox Content="自动开启「离线 AI 抠图换底」"
                                  IsChecked="{Binding HotFolderAutoBackgroundReplace}"
                                  IsEnabled="{Binding HasAiMattingModel}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,8"
                                    Visibility="{Binding HotFolderAutoBackgroundReplace, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="默认底色：" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Width="22" Height="22" Margin="0,0,5,0" Background="#FFFFFF" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" ToolTip="纯白底 #FFFFFF" Command="{Binding SetHotFolderBgColorCommand}" CommandParameter="#FFFFFF" />
                            <Button Width="22" Height="22" Margin="0,0,5,0" Background="#438EDB" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" ToolTip="公安标准蓝 #438EDB" Command="{Binding SetHotFolderBgColorCommand}" CommandParameter="#438EDB" />
                            <Button Width="22" Height="22" Margin="0,0,5,0" Background="#2B6CB0" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" ToolTip="深海商务蓝 #2B6CB0" Command="{Binding SetHotFolderBgColorCommand}" CommandParameter="#2B6CB0" />
                            <Button Width="22" Height="22" Margin="0,0,8,0" Background="#D9001B" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" ToolTip="标准大红底 #D9001B" Command="{Binding SetHotFolderBgColorCommand}" CommandParameter="#D9001B" />
                            <Border Width="14" Height="14" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,5,0"
                                    Background="{Binding HotFolderReplacementBgHex, Converter={StaticResource HexToBrush}}"
                                    BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" />
                            <TextBlock Text="{Binding HotFolderReplacementBgHex}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource BrushTextSecondary}" />
                        </StackPanel>

                        <CheckBox Content="自动智能构图"
                                  ToolTip="证件照使用人脸检测，日常照片按画面内容构图。"
                                  IsChecked="{Binding HotFolderAutoFaceFrame}" Margin="0,0,0,2" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
