<Window x:Class="PhotoPrintStudio.App.Views.HotFolderWatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PhotoPrintStudio.App.Controls"
        Title="联机拍摄监视"
        Width="560" Height="640" MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource StudioWindow}"
        Background="{DynamicResource BrushBgPanel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">

            <!-- 状态与启停 -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource BrushBgHeader}" BorderBrush="{DynamicResource BrushBorderSubtle}"
                    BorderThickness="0,0,0,1" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource BrushTextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHotFolderWatching}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource BrushStatusOk}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
                                        <Setter Property="Text" Value="未在监视" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHotFolderWatching}" Value="True">
                                                <Setter Property="Text" Value="正在监视" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding HotFolderStatusSummary}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding HotFolderLastEventText}" Style="{StaticResource Caption}" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHotFolderWatching}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Content="导入已有照片并监视" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6"
                                ToolTip="先导入文件夹中已有的照片，再继续监视新照片"
                                Command="{Binding ImportExistingAndWatchHotFolderCommand}" />
                        <Button Content="仅监视新照片" Style="{StaticResource ModernButton}"
                                Command="{Binding WatchNewHotFolderPhotosCommand}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="停止监视" Style="{StaticResource ModernButton}"
                            VerticalAlignment="Center" MinWidth="96"
                            Visibility="{Binding IsHotFolderWatching, Converter={StaticResource BoolToVis}}"
                            Command="{Binding StopHotFolderWatchCommand}" />
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,20,8">
                <StackPanel>
                    <!-- 监视文件夹 -->
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="监视文件夹" Style="{StaticResource DialogHeading}" />
                            <TextBlock Text="把联机软件（EOS Utility、Imaging Edge 等）的保存位置设为这个文件夹。"
                                       Style="{StaticResource Caption}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding HotFolderWatchDirectory, UpdateSourceTrigger=LostFocus}"
                                         AutomationProperties.Name="监视文件夹路径" ToolTip="相机输出照片所在的本地文件夹" />
                                <Button Grid.Column="1" Content="浏览…" Style="{StaticResource ModernButton}" Margin="6,0,0,0"
                                        Command="{Binding BrowseHotFolderDirectoryCommand}" />
                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="2,0,0,0"
                                        ToolTip="在资源管理器中打开" AutomationProperties.Name="打开文件夹"
                                        IsEnabled="{Binding HasHotFolderDirectory}"
                                        Command="{Binding OpenHotFolderDirectoryCommand}">
                                    <Path Data="{StaticResource IconFolder}" Style="{StaticResource VecIcon}" />
                                </Button>
                            </Grid>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="立即补扫" Style="{StaticResource MiniButton}"
                                        ToolTip="导入该文件夹中尚未导入的照片（监视中可用）"
                                        IsEnabled="{Binding IsHotFolderWatching}"
                                        Command="{Binding ScanHotFolderExistingNowCommand}" />
                                <CheckBox Content="包含子文件夹" IsChecked="{Binding HotFolderIncludeSubdirectories}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- 新照片放置 -->
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="新照片放置" Style="{StaticResource DialogHeading}" />
                            <ComboBox ItemsSource="{Binding HotFolderPlacementOptions}"
                                      DisplayMemberPath="Value"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding HotFolderPlacementStrategy, Mode=TwoWay}"
                                      AutomationProperties.Name="新照片放置方式" Margin="0,0,0,6" />
                            <TextBlock Text="连拍试拍时建议选“替换当前页成片”：样张都保留在素材池，打印页只保留当前满意的一张。"
                                       Style="{StaticResource Caption}" Margin="0,0,0,8" />
                            <CheckBox Content="新照片到达后自动选中并预览" IsChecked="{Binding HotFolderAutoSelectLatest}" />
                        </StackPanel>
                    </Border>

                    <!-- 自动处理 -->
                    <Border Style="{StaticResource PanelCard}" BorderThickness="0">
                        <StackPanel>
                            <TextBlock Text="自动处理" Style="{StaticResource DialogHeading}" />
                            <TextBlock Text="调色来源" Style="{StaticResource FormLabel}" />
                            <ComboBox ItemsSource="{Binding HotFolderEditTemplateOptions}"
                                      DisplayMemberPath="Value"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding HotFolderEditTemplateMode, Mode=TwoWay}"
                                      AutomationProperties.Name="调色来源" Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,8" Visibility="{Binding IsHotFolderPresetPickerVisible, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="预设" Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Presets}"
                                          SelectedItem="{Binding HotFolderSelectedColorPreset, Mode=TwoWay}"
                                          DisplayMemberPath="Name" AutomationProperties.Name="调色预设" />
                            </Grid>

                            <CheckBox Content="影棚自动优化" IsChecked="{Binding HotFolderAutoStudioEnhance}" Margin="0,4,0,4" />
                            <StackPanel Margin="21,0,0,8" Visibility="{Binding HotFolderAutoStudioEnhance, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="优化风格" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding StudioEnhanceModeOptions}"
                                              DisplayMemberPath="Value"
                                              SelectedValuePath="Key"
                                              SelectedValue="{Binding HotFolderStudioEnhanceMode, Mode=TwoWay}"
                                              AutomationProperties.Name="优化风格" />
                                </Grid>
                                <controls:StudioSliderRow Title="优化强度" Minimum="0" Maximum="100" Step="5" DefaultValue="70"
                                                          Value="{Binding HotFolderStudioEnhanceStrength}" />
                            </StackPanel>

                            <CheckBox Content="AI 抠图换底"
                                      IsChecked="{Binding HotFolderAutoBackgroundReplace}"
                                      IsEnabled="{Binding HasAiMattingModel}"
                                      ToolTipService.ShowOnDisabled="True"
                                      ToolTip="自动对新导入照片执行离线人像抠图换底（需在设置 → 高级中加载 ONNX 抠图模型）"
                                      Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal" Margin="21,2,0,8"
                                        Visibility="{Binding HotFolderAutoBackgroundReplace, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource SwatchButton}" Background="#FFFFFF" ToolTip="白 #FFFFFF" AutomationProperties.Name="白色底" Command="{Binding SetHotFolderBgColorCommand}" CommandParameter="#FFFFFF" />
                                <Button Style="{StaticResource SwatchButton}" Background="#438EDB" ToolTip="证件蓝 #438EDB" AutomationProperties.Name="证件蓝底" Command="{Binding SetHotFolderBgColorCommand}" CommandParameter="#438EDB" />
                                <Button Style="{StaticResource SwatchButton}" Background="#2B6CB0" ToolTip="深蓝 #2B6CB0" AutomationProperties.Name="深蓝底" Command="{Binding SetHotFolderBgColorCommand}" CommandParameter="#2B6CB0" />
                                <Button Style="{StaticResource SwatchButton}" Background="#D9001B" ToolTip="证件红 #D9001B" AutomationProperties.Name="证件红底" Command="{Binding SetHotFolderBgColorCommand}" CommandParameter="#D9001B" />
                                <TextBlock VerticalAlignment="Center" Margin="6,0,0,4" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}">
                                    <Run Text="当前 " /><Run Text="{Binding HotFolderReplacementBgHex, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <CheckBox Content="智能构图" ToolTip="证件照按人脸构图，日常照片按画面内容构图"
                                      IsChecked="{Binding HotFolderAutoFaceFrame}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="关闭" IsCancel="True" Style="{StaticResource DialogButton}" />
                <TextBlock Text="联机导入不会自动打印，打印仍需在主界面手动确认。" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
