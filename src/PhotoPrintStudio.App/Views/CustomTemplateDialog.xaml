<Window x:Class="PhotoPrintStudio.App.Views.CustomTemplateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建排版模板"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushBgPanel}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="将当前或自定义布局参数存为持久模板" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />

            <TextBlock Text="模板名称" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11.5" />
            <TextBox x:Name="NameBox" Margin="0,4,0,10" Text="我的自定义排版" />

            <TextBlock Text="说明备注" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11.5" />
            <TextBox x:Name="SubBox" Margin="0,4,0,10" />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="所属分类" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11.5" />
                    <ComboBox x:Name="ScenarioCombo" Margin="0,4,0,0" SelectionChanged="SettingsChanged">
                        <ComboBoxItem Content="日常打印 / 单张照片" Tag="SinglePhoto" />
                        <ComboBoxItem Content="证件照排版" Tag="IdPhoto" />
                        <ComboBoxItem Content="日常打印 / 六寸二合一" Tag="SixInchTwoInOne" />
                        <ComboBoxItem Content="拍立得样式" Tag="Polaroid" />
                        <ComboBoxItem Content="日常打印 / 自由网格" Tag="FreeGrid" IsSelected="True" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="默认纸张" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11.5" />
                    <ComboBox x:Name="PaperCombo" Margin="0,4,0,0" DisplayMemberPath="Name" SelectionChanged="SettingsChanged" />
                </StackPanel>
            </Grid>

            <CheckBox x:Name="FixedPolaroidGrid" Content="指定行列，必要时等比缩小" Margin="0,0,0,8"
                      Checked="SettingsChanged" Unchecked="SettingsChanged" />
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="RowsPanel" Grid.Column="0">
                    <TextBlock Text="行数" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11.5" />
                    <TextBox x:Name="RowsBox" Margin="0,4,0,0" Text="2" TextChanged="SettingsChanged" />
                </StackPanel>
                <StackPanel x:Name="ColumnsPanel" Grid.Column="2">
                    <TextBlock Text="列数" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11.5" />
                    <TextBox x:Name="ColsBox" Margin="0,4,0,0" Text="2" TextChanged="SettingsChanged" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="圆角 (mm)" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11.5" />
                    <TextBox x:Name="RadiusBox" Margin="0,4,0,0" Text="1.0" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="外边距 (mm)" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11.5" />
                    <TextBox x:Name="MarginBox" Margin="0,4,0,0" Text="5.0" TextChanged="SettingsChanged" />
                </StackPanel>
                <StackPanel x:Name="GapPanel" Grid.Column="2">
                    <TextBlock Text="间距 (mm)" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11.5" />
                    <TextBox x:Name="GapBox" Margin="0,4,0,0" Text="4.0" TextChanged="SettingsChanged" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="出血 (mm)" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11.5" />
                    <TextBox x:Name="BleedBox" Margin="0,4,0,0" Text="0.0" />
                </StackPanel>
            </Grid>

            <CheckBox x:Name="LandscapeCheck" Content="横向纸张" IsChecked="True" Margin="0,4,0,0"
                      Checked="SettingsChanged" Unchecked="SettingsChanged" />
            <TextBlock x:Name="CapacityText" TextWrapping="Wrap" Margin="0,8,0,14" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Style="{StaticResource ModernButton}" Click="Cancel_Click" Margin="0,0,8,0" Width="76" />
            <Button x:Name="SaveButton" Content="保存并应用模板" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save_Click" Width="130" />
        </StackPanel>
    </Grid>
</Window>
