<Window x:Class="PhotoPrintStudio.App.Views.CustomPaperDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义纸张尺寸"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource StudioWindow}"
        Background="{DynamicResource BrushBgPanel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
            <StackPanel Margin="20,16,20,16">
                <TextBlock Text="单位 mm。保存后加入纸张列表并选中。" Style="{StaticResource Caption}" Margin="0,0,0,12" />

                <TextBlock Text="名称" Style="{StaticResource FormLabel}" />
                <TextBox x:Name="NameBox" Margin="0,0,0,10" Text="10寸 / 8R (203.2×254.0 mm)" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="短边 mm" Style="{StaticResource FormLabel}" />
                        <TextBox x:Name="WidthBox" Style="{StaticResource NumericInput}" Margin="0" Text="203.2" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="长边 mm" Style="{StaticResource FormLabel}" />
                        <TextBox x:Name="HeightBox" Style="{StaticResource NumericInput}" Margin="0" Text="254.0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource DialogButton}" IsCancel="True" Click="Cancel_Click" />
                    <Button Content="保存" Style="{StaticResource DialogPrimaryButton}" IsDefault="True" Click="Save_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
