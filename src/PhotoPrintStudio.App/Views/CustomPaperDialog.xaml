<Window x:Class="PhotoPrintStudio.App.Views.CustomPaperDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建自定义相纸规格 (mm)"
        Width="390" Height="270"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushBgPanel}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="定义实体物理相纸宽高（保存至便携目录 config.json）"
                       Foreground="{DynamicResource BrushTextSecondary}" FontSize="11.5" Margin="0,0,0,12" />

            <TextBlock Text="规格名称" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11.5" />
            <TextBox x:Name="NameBox" Margin="0,4,0,10" Height="28" Padding="8,4" Text="10寸 / 8R (203.2×254.0 mm)" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="纸张短边宽 (mm)" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11.5" />
                    <TextBox x:Name="WidthBox" Margin="0,4,0,0" Height="28" Padding="8,4" Text="203.2" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="纸张长边高 (mm)" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11.5" />
                    <TextBox x:Name="HeightBox" Margin="0,4,0,0" Height="28" Padding="8,4" Text="254.0" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource ModernButton}" IsCancel="True" Click="Cancel_Click" Width="74" Margin="0,0,8,0" />
            <Button Content="保存并选中" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" Width="96" />
        </StackPanel>
    </Grid>
</Window>
