<Window x:Class="PhotoPrintStudio.App.Views.WorkspaceRestoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="恢复上次工作" Width="390" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource BrushBgPanel}" PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="20">
        <TextBlock x:Name="WorkspaceSummary" FontSize="14" TextWrapping="Wrap" />
        <TextBlock Text="重新开始会清除上次的暂存记录。"
                   Margin="0,8,0,18" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="重新开始" Style="{StaticResource ModernButton}" MinWidth="90"
                    Margin="0,0,8,0" Click="StartFresh_Click" />
            <Button Content="恢复上次工作" Style="{StaticResource PrimaryButton}" MinWidth="110" Click="Restore_Click" />
        </StackPanel>
    </StackPanel>
</Window>
