<Window x:Class="PhotoPrintStudio.App.Views.CustomLayoutEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PhotoPrintStudio.App.Controls"
        Title="{Binding WindowTitle}"
        Width="1180" Height="760"
        MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource StudioWindow}"
        Background="{DynamicResource BrushBgCanvasWell}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. 顶部栏：模板名称 / 分类 / 纸张与方向 ==================== -->
        <Border Grid.Row="0" Background="{DynamicResource BrushBgHeader}"
                BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="168" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="170" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="版式名称" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                <TextBox x:Name="TemplateNameBox" Grid.Column="1" Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="自定义版式名称" AutomationProperties.Name="版式名称" />

                <TextBlock Grid.Column="3" Text="所属分类" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                <ComboBox Grid.Column="4" ItemsSource="{Binding ScenarioOptions}" DisplayMemberPath="Value" SelectedValuePath="Key"
                          SelectedValue="{Binding Scenario, Mode=TwoWay}" ToolTip="保存到模板库的分类" AutomationProperties.Name="所属分类" />

                <TextBlock Grid.Column="6" Text="纸张" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                <ComboBox Grid.Column="7" ItemsSource="{Binding PaperSizes}" SelectedItem="{Binding SelectedPaper, Mode=TwoWay}"
                          DisplayMemberPath="Name" ToolTip="设计所用的物理纸张尺寸" AutomationProperties.Name="纸张尺寸" />

                <Border Grid.Column="9" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentRadio}" Content="纵向" Padding="10,2"
                                     IsChecked="{Binding IsLandscape, Converter={StaticResource InverseBool}, Mode=TwoWay}"
                                     ToolTip="纸张纵向（竖排）" />
                        <RadioButton Style="{StaticResource SegmentRadio}" Content="横向" Padding="10,2"
                                     IsChecked="{Binding IsLandscape, Mode=TwoWay}"
                                     ToolTip="纸张横向（横排）" />
                    </StackPanel>
                </Border>

                <ComboBox Grid.Column="11" Width="126" ItemsSource="{Binding CropMarkStyles}"
                          DisplayMemberPath="Value" SelectedValuePath="Key"
                          SelectedValue="{Binding CropMarkStyle, Mode=TwoWay}"
                          ToolTip="默认裁切标记样式" AutomationProperties.Name="裁切标记" />
            </Grid>
        </Border>

        <!-- ==================== 2. 工具栏：添加 / 生成 / 编辑 / 对齐与分布 ==================== -->
        <Border Grid.Row="1" Background="{DynamicResource BrushBgPanel}"
                BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="10,5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddFrameCommand}" Padding="10,3"
                        ToolTip="添加一个新图片框（也可双击画布空白处添加）">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Style="{StaticResource VecIcon}" Width="11" Height="11" Margin="0,0,5,0" />
                        <TextBlock Text="添加图片框" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>

                <Button x:Name="QuickGenBtn" Style="{StaticResource ModernButton}" Margin="6,0,0,0" Padding="9,3"
                        Click="QuickGenBtn_Click" ToolTip="快速生成均分网格、常用尺寸铺满或从已有模板导入">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconGrid}" Style="{StaticResource VecIcon}" Width="12" Height="12" Margin="0,0,5,0" />
                        <TextBlock Text="快速生成" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <Path Data="{StaticResource IconChevronDown}" Style="{StaticResource VecIcon}" Width="9" Height="9" Margin="4,1,0,0" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource ToolbarDivider}" Margin="8,0" />

                <Button Style="{StaticResource IconButton}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip="撤销 (Ctrl+Z)">
                    <Path Data="{StaticResource IconUndo}" Style="{StaticResource VecIcon}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" ToolTip="重做 (Ctrl+Y)">
                    <Path Data="{StaticResource IconRedo}" Style="{StaticResource VecIcon}" />
                </Button>

                <Border Style="{StaticResource ToolbarDivider}" Margin="6,0" />

                <Button Style="{StaticResource IconButton}" Command="{Binding DuplicateSelectedFramesCommand}" IsEnabled="{Binding HasSelection}" ToolTip="复制选中图片框 (Ctrl+D)">
                    <Path Data="{StaticResource IconCopy}" Style="{StaticResource VecIcon}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding RotateSelected90Command}" IsEnabled="{Binding HasSelection}" ToolTip="旋转照片方向 90° (R)">
                    <Path Data="{StaticResource IconRotateRight}" Style="{StaticResource VecIcon}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding SwapSelectedWidthHeightCommand}" IsEnabled="{Binding HasSelection}" ToolTip="交换图片框宽高">
                    <Path Data="{StaticResource IconSwapSize}" Style="{StaticResource VecIcon}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding DeleteSelectedFramesCommand}" IsEnabled="{Binding HasSelection}" ToolTip="删除选中图片框 (Delete)">
                    <Path Data="{StaticResource IconTrash}" Style="{StaticResource VecIcon}" />
                </Button>

                <Border Style="{StaticResource ToolbarDivider}" Margin="6,0" />

                <!-- 对齐与分布 -->
                <Button Style="{StaticResource IconButton}" Command="{Binding AlignLeftCommand}" IsEnabled="{Binding HasSelection}" ToolTip="左对齐（单选对纸张，多选对选区）">
                    <Path Data="{StaticResource IconAlignLeft}" Style="{StaticResource VecIcon}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding AlignCenterHCommand}" IsEnabled="{Binding HasSelection}" ToolTip="水平居中对齐">
                    <Path Data="{StaticResource IconAlignCenterH}" Style="{StaticResource VecIcon}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding AlignRightCommand}" IsEnabled="{Binding HasSelection}" ToolTip="右对齐">
                    <Path Data="{StaticResource IconAlignRight}" Style="{StaticResource VecIcon}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding AlignTopCommand}" IsEnabled="{Binding HasSelection}" ToolTip="顶部对齐">
                    <Path Data="{StaticResource IconAlignTop}" Style="{StaticResource VecIcon}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding AlignCenterVCommand}" IsEnabled="{Binding HasSelection}" ToolTip="垂直居中对齐">
                    <Path Data="{StaticResource IconAlignCenterV}" Style="{StaticResource VecIcon}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding AlignBottomCommand}" IsEnabled="{Binding HasSelection}" ToolTip="底部对齐">
                    <Path Data="{StaticResource IconAlignBottom}" Style="{StaticResource VecIcon}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding CenterOnPageCommand}" IsEnabled="{Binding HasSelection}" ToolTip="在纸张正中居中">
                    <Path Data="{StaticResource IconAlignCenterPage}" Style="{StaticResource VecIcon}" />
                </Button>

                <Border Style="{StaticResource ToolbarDivider}" Margin="4,0" />

                <Button Style="{StaticResource IconButton}" Command="{Binding DistributeHorizontalCommand}" IsEnabled="{Binding CanDistribute}" ToolTip="水平等距分布（需选中 3 个及以上）">
                    <Path Data="{StaticResource IconDistributeH}" Style="{StaticResource VecIcon}" />
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding DistributeVerticalCommand}" IsEnabled="{Binding CanDistribute}" ToolTip="垂直等距分布（需选中 3 个及以上）">
                    <Path Data="{StaticResource IconDistributeV}" Style="{StaticResource VecIcon}" />
                </Button>
                <Button Style="{StaticResource MiniButton}" Content="等宽" Margin="4,0,0,0"
                        Command="{Binding MatchSelectedWidthCommand}" IsEnabled="{Binding HasMultiSelection}"
                        ToolTip="将选中框宽度统一为主选框宽度" />
                <Button Style="{StaticResource MiniButton}" Content="等高" Margin="4,0,0,0"
                        Command="{Binding MatchSelectedHeightCommand}" IsEnabled="{Binding HasMultiSelection}"
                        ToolTip="将选中框高度统一为主选框高度" />
            </StackPanel>
        </Border>

        <!-- 快速生成弹出层 -->
        <Popup x:Name="QuickGenPopup" PlacementTarget="{Binding ElementName=QuickGenBtn}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderStrong}"
                    BorderThickness="1" CornerRadius="6" Padding="14" Width="320" Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.22" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="1. 快速生成均分网格" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <UniformGrid Columns="2" Margin="0,0,-8,6">
                        <StackPanel Margin="0,0,8,6">
                            <TextBlock Text="行数" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="PopupGridRowsBox" Style="{StaticResource NumericInput}" Text="{Binding GridRows, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,6">
                            <TextBlock Text="列数" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="PopupGridColsBox" Style="{StaticResource NumericInput}" Text="{Binding GridCols, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,6">
                            <TextBlock Text="外边距 (mm)" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="PopupGridMarginBox" Style="{StaticResource NumericInput}" Text="{Binding GridMarginMm, StringFormat=0.#, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,6">
                            <TextBlock Text="间距 (mm)" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="PopupGridGapBox" Style="{StaticResource NumericInput}" Text="{Binding GridGapMm, StringFormat=0.#, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                    </UniformGrid>
                    <Button Style="{StaticResource PrimaryButton}" Content="生成均分网格" HorizontalAlignment="Stretch"
                            Click="ApplyQuickGrid_Click" />

                    <Separator Margin="0,12" />

                    <TextBlock Text="2. 按标准尺寸自动铺满纸张" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <ComboBox ItemsSource="{Binding SizePresets}" SelectedItem="{Binding SelectedFixedTilePreset, Mode=TwoWay}" Margin="0,0,0,8" />
                    <Button Style="{StaticResource ModernButton}" Content="按此尺寸铺满" HorizontalAlignment="Stretch"
                            Click="ApplyQuickFixedTile_Click" />

                    <Separator Margin="0,12" />

                    <TextBlock Text="3. 从内置模板载入并自由修改" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                    <ComboBox x:Name="ImportTemplateCombo" ItemsSource="{Binding ImportableTemplates}" DisplayMemberPath="Name" Margin="0,0,0,8" />
                    <Button Style="{StaticResource ModernButton}" Content="载入所选模板到画布" HorizontalAlignment="Stretch"
                            Click="ImportSelectedTemplate_Click" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- ==================== 3. 主工作区：左标尺画布 | 右图片框列表 + 属性 + 边距示意图 ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="460" />
                <ColumnDefinition Width="312" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：画布视图控制条 + 物理标尺 + 交互画布 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource BrushBgHeader}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="10,4">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButtonSmall}" Click="ZoomOut_Click" ToolTip="缩小画布 (Ctrl+滚轮)">
                                <Path Data="{StaticResource IconMinus}" Style="{StaticResource VecIcon}" Width="11" Height="11" />
                            </Button>
                            <Button x:Name="ZoomFitBtn" Style="{StaticResource GhostButton}" Padding="6,0" MinHeight="22" Click="ZoomFit_Click" ToolTip="适应窗口">
                                <TextBlock x:Name="ZoomPercentText" Text="适应" FontSize="11" VerticalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource IconButtonSmall}" Click="ZoomIn_Click" ToolTip="放大画布 (Ctrl+滚轮)">
                                <Path Data="{StaticResource IconPlus}" Style="{StaticResource VecIcon}" Width="11" Height="11" />
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource PillToggleButton}" Content="磁吸对齐" Padding="8,2" MinHeight="22"
                                          IsChecked="{Binding EnableMagneticSnap, Mode=TwoWay}"
                                          ToolTip="拖拽与缩放时自动吸附纸张中心、边线与其他图片框（按住 Alt 临时关闭）" />
                            <ToggleButton Style="{StaticResource PillToggleButton}" Content="网格" Padding="8,2" MinHeight="22" Margin="4,0,0,0"
                                          IsChecked="{Binding ShowGrid, Mode=TwoWay}" ToolTip="显示/隐藏毫米网格线" />
                            <ToggleButton Style="{StaticResource PillToggleButton}" Content="照片底图" Padding="8,2" MinHeight="22" Margin="4,0,0,0"
                                          IsChecked="{Binding ShowSampleOverlay, Mode=TwoWay}" ToolTip="在图片框内显示半透明照片以辅助观察朝向" />
                            <ToggleButton Style="{StaticResource PillToggleButton}" Content="安全边距" Padding="8,2" MinHeight="22" Margin="4,0,0,0"
                                          IsChecked="{Binding ShowSafeMargin, Mode=TwoWay}" ToolTip="显示打印机硬件安全边距参考线" />
                            <TextBlock Text="双击空白添加图片框，Alt 暂停吸附，Shift 切换锁定比例"
                                       FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid x:Name="ViewportHost" Grid.Row="1" Background="{DynamicResource BrushBgCanvasWell}"
                      SizeChanged="ViewportHost_SizeChanged"
                      PreviewMouseWheel="ViewportHost_PreviewMouseWheel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 标尺左上角单位标记 -->
                    <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource BrushRulerBg}"
                            BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,1,1">
                        <TextBlock Text="mm" FontSize="9" Foreground="{DynamicResource BrushTextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <controls:PhysicalRulerControl x:Name="TopRuler" Grid.Row="0" Grid.Column="1" IsVertical="False" />
                    <controls:PhysicalRulerControl x:Name="LeftRuler" Grid.Row="1" Grid.Column="0" IsVertical="True" />

                    <ScrollViewer x:Name="CanvasScroller" Grid.Row="1" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="CanvasScroller_ScrollChanged"
                                  PreviewMouseDown="CanvasScroller_PreviewMouseDown"
                                  PreviewMouseMove="CanvasScroller_PreviewMouseMove"
                                  PreviewMouseUp="CanvasScroller_PreviewMouseUp"
                                  LostMouseCapture="CanvasScroller_LostMouseCapture"
                                  Background="Transparent">
                        <Grid Margin="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="PaperShadowHost" Background="White">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" Color="#000000" />
                                </Border.Effect>
                                <controls:LayoutDesignerCanvas x:Name="DesignerCanvas" ViewModel="{Binding}" />
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- 右侧边栏：上图片框列表 / 中精确参数 / 下可视化四边距示意图 -->
            <Border Grid.Column="1" Background="{DynamicResource BrushBgPanel}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="175" MinHeight="120" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 上部：图片框列表（对应参考图右上） -->
                    <DockPanel Grid.Row="0" Margin="10,10,10,6">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource IconButtonSmall}" Command="{Binding MoveSelectedUpCommand}"
                                        IsEnabled="{Binding IsSingleSelection}" ToolTip="上移一层">
                                    <Path Data="{StaticResource IconArrowUp}" Style="{StaticResource VecIcon}" Width="11" Height="11" />
                                </Button>
                                <Button Style="{StaticResource IconButtonSmall}" Command="{Binding MoveSelectedDownCommand}"
                                        IsEnabled="{Binding IsSingleSelection}" ToolTip="下移一层">
                                    <Path Data="{StaticResource IconArrowDown}" Style="{StaticResource VecIcon}" Width="11" Height="11" />
                                </Button>
                                <Button Style="{StaticResource IconButtonSmall}" Command="{Binding AddFrameCommand}" ToolTip="添加图片框">
                                    <Path Data="{StaticResource IconPlus}" Style="{StaticResource VecIcon}" Width="11" Height="11" />
                                </Button>
                                <Button Style="{StaticResource IconButtonSmall}" Command="{Binding ClearAllFramesCommand}" ToolTip="清空全部图片框">
                                    <Path Data="{StaticResource IconTrash}" Style="{StaticResource VecIcon}" Width="11" Height="11" />
                                </Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource PanelTitle}">
                                <Run Text="图片框列表 (" /><Run Text="{Binding Frames.Count, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                        </DockPanel>

                        <ListBox x:Name="FramesList"
                                 ItemsSource="{Binding Frames}"
                                 SelectionMode="Extended"
                                 SelectionChanged="FramesList_SelectionChanged"
                                 Background="{DynamicResource BrushBgCard}"
                                 BorderBrush="{DynamicResource BrushBorderSubtle}"
                                 BorderThickness="1" Padding="3"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListItem}">
                                    <Setter Property="Margin" Value="0,0,0,2" />
                                    <Setter Property="Padding" Value="6,4" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:FrameMiniThumbControl Grid.Column="0" Width="36" Height="26"
                                            PaperWidthMm="{Binding DataContext.PaperWidthMm, RelativeSource={RelativeSource AncestorType=Window}}"
                                            PaperHeightMm="{Binding DataContext.PaperHeightMm, RelativeSource={RelativeSource AncestorType=Window}}"
                                            FrameXMm="{Binding XMm}"
                                            FrameYMm="{Binding YMm}"
                                            FrameWidthMm="{Binding WidthMm}"
                                            FrameHeightMm="{Binding HeightMm}"
                                            IsOutOfBounds="{Binding IsOutOfBounds}" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DimensionsSummary}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushStatusError}" Text="越界"
                                                   Visibility="{Binding IsOutOfBounds, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- 中部：选中图片框精确尺寸与位置设置 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="10,10,10,10">
                            <StackPanel IsEnabled="{Binding HasSelection}">
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource MiniButton}" Content="收回纸内"
                                            Command="{Binding ClampAllFramesIntoPaperCommand}"
                                            Visibility="{Binding HasOutOfBounds, Converter={StaticResource BoolToVis}}"
                                            ToolTip="将所有超出纸张的图片框自动收回纸张范围内" />
                                    <TextBlock Text="{Binding SelectedCountText}" Style="{StaticResource CardTitle}" />
                                </DockPanel>

                                <!-- 常用尺寸速选 -->
                                <TextBlock Text="常用尺寸预设" Style="{StaticResource FormLabel}" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="SizePresetCombo" Grid.Column="0" ItemsSource="{Binding SizePresets}"
                                              SelectionChanged="SizePresetCombo_SelectionChanged"
                                              ToolTip="快速将选中图片框设置为常用冲印或证件照尺寸" />
                                    <Button Grid.Column="2" Style="{StaticResource MiniButton}" Content="满版"
                                            Command="{Binding FitSelectedToPaperCommand}" ToolTip="铺满整张纸" />
                                </Grid>

                                <!-- 位置 X / Y 与 尺寸 W / H -->
                                <UniformGrid Columns="2" Margin="0,0,-8,0">
                                    <StackPanel Margin="0,0,8,6">
                                        <TextBlock Text="左边距 X (mm)" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="BoxX" Style="{StaticResource NumericInput}"
                                                 Text="{Binding SelectedXMm, StringFormat=0.##, Mode=OneWay}"
                                                 Tag="X" LostFocus="NumericBox_Commit" PreviewKeyDown="NumericBox_PreviewKeyDown" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,6">
                                        <TextBlock Text="上边距 Y (mm)" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="BoxY" Style="{StaticResource NumericInput}"
                                                 Text="{Binding SelectedYMm, StringFormat=0.##, Mode=OneWay}"
                                                 Tag="Y" LostFocus="NumericBox_Commit" PreviewKeyDown="NumericBox_PreviewKeyDown" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,6">
                                        <TextBlock Text="宽度 W (mm)" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="BoxW" Style="{StaticResource NumericInput}"
                                                 Text="{Binding SelectedWidthMm, StringFormat=0.##, Mode=OneWay}"
                                                 Tag="W" LostFocus="NumericBox_Commit" PreviewKeyDown="NumericBox_PreviewKeyDown" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,6">
                                        <TextBlock Text="高度 H (mm)" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="BoxH" Style="{StaticResource NumericInput}"
                                                 Text="{Binding SelectedHeightMm, StringFormat=0.##, Mode=OneWay}"
                                                 Tag="H" LostFocus="NumericBox_Commit" PreviewKeyDown="NumericBox_PreviewKeyDown" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,6">
                                        <TextBlock Text="右边距 (mm)" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="BoxRightMargin" Style="{StaticResource NumericInput}"
                                                 Text="{Binding SelectedRightMarginMm, StringFormat=0.##, Mode=OneWay}"
                                                 Tag="R" LostFocus="NumericBox_Commit" PreviewKeyDown="NumericBox_PreviewKeyDown" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,6">
                                        <TextBlock Text="下边距 (mm)" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="BoxBottomMargin" Style="{StaticResource NumericInput}"
                                                 Text="{Binding SelectedBottomMarginMm, StringFormat=0.##, Mode=OneWay}"
                                                 Tag="B" LostFocus="NumericBox_Commit" PreviewKeyDown="NumericBox_PreviewKeyDown" />
                                    </StackPanel>
                                </UniformGrid>

                                <CheckBox Content="锁定宽高比（拖动缩放时按 Shift 也可临时切换）"
                                          IsChecked="{Binding LockAspectRatio, Mode=TwoWay}" Margin="0,2,0,8" />

                                <!-- 方向、圆角、出血 -->
                                <UniformGrid Columns="3" Margin="0,0,-6,6">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="照片方向" Style="{StaticResource FormLabel}" />
                                        <ComboBox ItemsSource="{Binding RotationOptions}" SelectedItem="{Binding SelectedRotationDegrees, Mode=TwoWay}"
                                                  ItemStringFormat="{}{0:0}°" ToolTip="照片在图片框内的旋转角度（红边表示照片底边）" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="圆角 mm" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="BoxRadius" Style="{StaticResource NumericInput}"
                                                 Text="{Binding SelectedCornerRadiusMm, StringFormat=0.##, Mode=OneWay}"
                                                 Tag="Radius" LostFocus="NumericBox_Commit" PreviewKeyDown="NumericBox_PreviewKeyDown" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="出血 mm" Style="{StaticResource FormLabel}" />
                                        <TextBox x:Name="BoxBleed" Style="{StaticResource NumericInput}"
                                                 Text="{Binding SelectedBleedMm, StringFormat=0.##, Mode=OneWay}"
                                                 Tag="Bleed" LostFocus="NumericBox_Commit" PreviewKeyDown="NumericBox_PreviewKeyDown" />
                                    </StackPanel>
                                </UniformGrid>

                                <!-- 适配模式与标签 -->
                                <Expander Header="高级属性（适配 / 名称 / 拍立得框）" Style="{StaticResource StudioExpander}" IsExpanded="False" Margin="0,2,0,0">
                                    <StackPanel>
                                        <TextBlock Text="图片框名称" Style="{StaticResource FormLabel}" />
                                        <TextBox Text="{Binding SelectedLabel, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,6" />

                                        <TextBlock Text="照片适配方式" Style="{StaticResource FormLabel}" />
                                        <ComboBox ItemsSource="{Binding FitModeOptions}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                                  SelectedValue="{Binding SelectedFitModeIndex, Mode=TwoWay}" Margin="0,0,0,8" />

                                        <CheckBox Content="作为拍立得白边相框" IsChecked="{Binding SelectedIsPolaroidFrame, Mode=TwoWay}" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding PolaroidSpecs}" SelectedItem="{Binding SelectedFramePolaroidSpec, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" Margin="0,0,0,4"
                                                  Visibility="{Binding SelectedIsPolaroidFrame, Converter={StaticResource BoolToVis}}" />

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" Content="网格吸附" IsChecked="{Binding EnableGridSnap, Mode=TwoWay}" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="2" ItemsSource="{Binding GridStepOptions}" SelectedItem="{Binding GridStepMm, Mode=TwoWay}"
                                                      ItemStringFormat="步长 {0:0.#} mm" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <!-- 底部：可视化尺寸与四边距示意盒（复刻参考图右下角核心设计） -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0"
                            Background="{DynamicResource BrushBgHeader}" Padding="10,8">
                        <controls:MarginDiagramControl x:Name="MarginDiagram" Height="158"
                                                       HasSelection="{Binding HasSelection}"
                                                       PaperWidthMm="{Binding PaperWidthMm}"
                                                       PaperHeightMm="{Binding PaperHeightMm}"
                                                       FrameXMm="{Binding SelectedXMm}"
                                                       FrameYMm="{Binding SelectedYMm}"
                                                       FrameWidthMm="{Binding SelectedWidthMm}"
                                                       FrameHeightMm="{Binding SelectedHeightMm}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 4. 底部状态与保存栏 ==================== -->
        <Border Grid.Row="3" Style="{StaticResource DialogFooter}" Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="取消" IsCancel="True" Style="{StaticResource DialogButton}" Click="Cancel_Click" />
                    <Button Content="仅应用到当前页" Style="{StaticResource DialogButton}" Margin="8,0,0,0"
                            IsEnabled="{Binding CanSave}" Click="ApplyOnly_Click"
                            ToolTip="直接更新当前排版页，不保存到左侧模板库" />
                    <Button Content="另存为新模板" Style="{StaticResource DialogButton}" Margin="8,0,0,0"
                            IsEnabled="{Binding CanSave}"
                            Visibility="{Binding IsEditingExistingTemplate, Converter={StaticResource BoolToVis}}"
                            Click="SaveAsNew_Click" />
                    <Button x:Name="SaveButton" Content="保存并应用" Style="{StaticResource DialogPrimaryButton}" Margin="8,0,0,0"
                            IsEnabled="{Binding CanSave}" Click="SaveAndApply_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding ValidationMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="11.5" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOutOfBounds}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushStatusError}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasOverlaps}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushStatusWarn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding PointerCoordText}" Margin="16,0,0,0" FontSize="11.5"
                               Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
