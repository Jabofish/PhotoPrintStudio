<Window x:Class="PhotoPrintStudio.App.Views.CustomPolaroidDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建自定义拍立得尺寸与白边框 (mm)"
        Width="440" Height="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushBgPanel}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="自由设定拍立得整卡外径、四周边框留白毫米与圆角（保存至 config.json）"
                       Foreground="{DynamicResource BrushTextSecondary}" FontSize="11.5" Margin="0,0,0,10" TextWrapping="Wrap" />

            <TextBlock Text="款式名称" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11.5" />
            <TextBox x:Name="NameBox" Margin="0,4,0,10" Height="28" Padding="8,4" Text="窄边复古方卡 (70×88 mm)" />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="整卡宽度 mm" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
                    <TextBox x:Name="CardWBox" Margin="0,4,0,0" Height="28" Padding="6,4" Text="70.0" TextChanged="Geometry_TextChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="整卡高度 mm" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
                    <TextBox x:Name="CardHBox" Margin="0,4,0,0" Height="28" Padding="6,4" Text="88.0" TextChanged="Geometry_TextChanged" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="圆角半径 mm" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
                    <TextBox x:Name="RadiusBox" Margin="0,4,0,0" Height="28" Padding="6,4" Text="1.2" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="上边框 mm" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
                    <TextBox x:Name="TopBox" Margin="0,4,0,0" Height="28" Padding="6,4" Text="4.0" TextChanged="Geometry_TextChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="左边框 mm" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
                    <TextBox x:Name="LeftBox" Margin="0,4,0,0" Height="28" Padding="6,4" Text="4.0" TextChanged="Geometry_TextChanged" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="右边框 mm" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
                    <TextBox x:Name="RightBox" Margin="0,4,0,0" Height="28" Padding="6,4" Text="4.0" TextChanged="Geometry_TextChanged" />
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="下巴宽度 mm" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
                    <TextBox x:Name="BottomBox" Margin="0,4,0,0" Height="28" Padding="6,4" Text="18.0" TextChanged="Geometry_TextChanged" />
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource BrushBgCard}" CornerRadius="6" Padding="10,8"
                    BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                <TextBlock x:Name="ComputedPhotoWindowText" Text="内框画面尺寸：62.0 × 66.0 mm"
                           Foreground="{DynamicResource BrushTextSecondary}" FontSize="11.5" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource ModernButton}" IsCancel="True" Click="Cancel_Click" Width="74" Margin="0,0,8,0" />
            <Button Content="保存并应用" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" Width="96" />
        </StackPanel>
    </Grid>
</Window>
