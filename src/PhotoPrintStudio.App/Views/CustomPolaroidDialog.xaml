<Window x:Class="PhotoPrintStudio.App.Views.CustomPolaroidDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义拍立得尺寸"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource StudioWindow}"
        Background="{DynamicResource BrushBgPanel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
            <StackPanel Margin="20,16,20,12">
                <TextBlock Text="单位 mm。保存后出现在拍立得型号列表中。" Style="{StaticResource Caption}" Margin="0,0,0,12" />

                <TextBlock Text="款式名称" Style="{StaticResource FormLabel}" />
                <TextBox x:Name="NameBox" Margin="0,0,0,10" Text="窄边复古方卡 (70×88 mm)" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="整卡宽 mm" Style="{StaticResource FormLabel}" />
                        <TextBox x:Name="CardWBox" Style="{StaticResource NumericInput}" Margin="0" Text="70.0" TextChanged="Geometry_TextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="整卡高 mm" Style="{StaticResource FormLabel}" />
                        <TextBox x:Name="CardHBox" Style="{StaticResource NumericInput}" Margin="0" Text="88.0" TextChanged="Geometry_TextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="圆角 mm" Style="{StaticResource FormLabel}" />
                        <TextBox x:Name="RadiusBox" Style="{StaticResource NumericInput}" Margin="0" Text="1.2" TextChanged="Geometry_TextChanged" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="上边框 mm" Style="{StaticResource FormLabel}" />
                        <TextBox x:Name="TopBox" Style="{StaticResource NumericInput}" Margin="0" Text="4.0" TextChanged="Geometry_TextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="左边框 mm" Style="{StaticResource FormLabel}" />
                        <TextBox x:Name="LeftBox" Style="{StaticResource NumericInput}" Margin="0" Text="4.0" TextChanged="Geometry_TextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="右边框 mm" Style="{StaticResource FormLabel}" />
                        <TextBox x:Name="RightBox" Style="{StaticResource NumericInput}" Margin="0" Text="4.0" TextChanged="Geometry_TextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="下边框 mm" Style="{StaticResource FormLabel}" />
                        <TextBox x:Name="BottomBox" Style="{StaticResource NumericInput}" Margin="0" Text="18.0" TextChanged="Geometry_TextChanged" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ComputedPhotoWindowText" Text="画面区域：62 × 66 mm" Style="{StaticResource Caption}" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource DialogButton}" IsCancel="True" Click="Cancel_Click" />
                    <Button x:Name="SaveButton" Content="保存" Style="{StaticResource DialogPrimaryButton}" IsDefault="True" Click="Save_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
