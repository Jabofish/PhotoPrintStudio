<Window x:Class="PhotoPrintStudio.App.Views.CalibrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打印校准"
        Width="520" Height="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResize"
        Style="{StaticResource StudioWindow}"
        Background="{DynamicResource BrushBgPanel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,4,20,8">
                <StackPanel>
                    <TextBlock x:Name="PrinterNameLabel" Style="{StaticResource Caption}" Margin="0,12,0,0" />

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="1  打印测试卡" Style="{StaticResource DialogHeading}" />
                            <TextBlock Text="本次尺寸校准用于当前纸型、方向和驱动设置。打印测试卡，量取横、纵标尺后填入下一步。"
                                       Style="{StaticResource Caption}" Margin="0,0,0,10" />
                            <Button Content="打印测试卡" Style="{StaticResource ModernButton}" Click="PrintTestCard_Click" HorizontalAlignment="Left" MinWidth="96" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="2  按实测长度计算缩放" Style="{StaticResource DialogHeading}" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="水平标称长度 mm" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="ExpHBox" Style="{StaticResource NumericInput}" Text="100" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="水平实测长度 mm" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="MeasHBox" Style="{StaticResource NumericInput}" Text="100" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="垂直标称长度 mm" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="ExpVBox" Style="{StaticResource NumericInput}" Text="50" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="垂直实测长度 mm" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="MeasVBox" Style="{StaticResource NumericInput}" Text="50" />
                                </StackPanel>
                            </Grid>
                            <Button Content="计算 X/Y 缩放" Style="{StaticResource ModernButton}" Click="AutoComputeScale_Click" HorizontalAlignment="Left" MinWidth="96"
                                    ToolTip="按标称与实测长度反算缩放比例，填入下方参数" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}" BorderThickness="0">
                        <StackPanel>
                            <TextBlock Text="3  微调参数" Style="{StaticResource DialogHeading}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="水平偏移 mm" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="OffsetXBox" Style="{StaticResource NumericInput}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="垂直偏移 mm" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="OffsetYBox" Style="{StaticResource NumericInput}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="X 缩放 %" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="ScaleXBox" Style="{StaticResource NumericInput}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="Y 缩放 %" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="ScaleYBox" Style="{StaticResource NumericInput}" />
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="0">
                                    <TextBlock Text="无边距扩张补偿 %" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="OverscanBox" Style="{StaticResource NumericInput}" />
                                </StackPanel>
                                <Button Grid.Row="4" Grid.Column="2" Content="佳能 CP 预设 97.5%" Style="{StaticResource ModernButton}"
                                        VerticalAlignment="Bottom" Click="PresetSublimationOverscan_Click"
                                        ToolTip="经验值，实际补偿量以同设置打印的测试卡为准" />
                                <StackPanel Grid.Row="6" Grid.Column="0">
                                    <TextBlock Text="双面背面 X 偏移 mm" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="DuplexXBox" Style="{StaticResource NumericInput}" />
                                </StackPanel>
                                <StackPanel Grid.Row="6" Grid.Column="2">
                                    <TextBlock Text="双面背面 Y 偏移 mm" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="DuplexYBox" Style="{StaticResource NumericInput}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="色彩补偿" Style="{StaticResource GroupLabel}" Margin="0,14,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="亮度" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="CompBrightBox" Style="{StaticResource NumericInput}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Gamma" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="CompGammaBox" Style="{StaticResource NumericInput}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="色温" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="CompTempBox" Style="{StaticResource NumericInput}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <Button Content="恢复默认" Style="{StaticResource GhostButton}" Click="ResetAll_Click" DockPanel.Dock="Left"
                        ToolTip="把下方所有参数恢复为默认值（保存后生效）" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource DialogButton}" Click="Cancel_Click" IsCancel="True" />
                    <Button Content="保存" Style="{StaticResource DialogPrimaryButton}" Click="Save_Click" IsDefault="True" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
