<Window x:Class="PhotoPrintStudio.App.Views.ShortcutsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="键盘快捷键"
        Width="760" Height="600" MinWidth="620" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource StudioWindow}"
        Background="{DynamicResource BrushBgPanel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,8,20,12">
                <UniformGrid x:Name="GroupsHost" Columns="2" VerticalAlignment="Top" />
            </ScrollViewer>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="关闭" IsCancel="True" IsDefault="True" Style="{StaticResource DialogButton}" />
                <TextBlock Text="单击画布或按 Alt+5 后，即可使用画布快捷键。" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
